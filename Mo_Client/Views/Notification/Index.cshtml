@model List<Mo_Client.Models.Notification>
@{
    ViewData["Title"] = "Thông báo";
    var isReadFilter = ViewBag.IsReadFilter as bool?;
    var unreadCount = ViewBag.UnreadCount as int? ?? 0;
    var totalCount = ViewBag.TotalCount as int? ?? 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/notification.css" asp-append-version="true" />
}

<div class="container-fluid notification-page">
    <div class="row">
        <div class="col-12">
            <!-- Header -->
            <div class="notification-header">
                <h2>
                    <i class="fas fa-bell"></i> Thông báo của tôi
                </h2>
                <p>
                    @if (isReadFilter == true)
                    {
                        <span>Đã đọc (@totalCount thông báo)</span>
                    }
                    else if (isReadFilter == false)
                    {
                        <span>Chưa đọc (@totalCount thông báo)</span>
                    }
                    else
                    {
                        <span>Tất cả (@totalCount thông báo, @unreadCount chưa đọc)</span>
                    }
                </p>
                @if (unreadCount > 0)
                {
                    <button class="btn mark-all-read-btn" id="markAllReadBtn">
                        <i class="fas fa-check-double"></i> Đánh dấu tất cả đã đọc
                    </button>
                }
            </div>

            <!-- Filter Tabs -->
            <div class="notification-tabs">
                <ul class="nav nav-pills nav-fill" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link @(isReadFilter == null ? "active" : "")" 
                               href="@Url.Action("Index", "Notification")">
                                <i class="fas fa-list"></i> Tất cả
                                @if (totalCount > 0)
                                {
                                    <span class="badge bg-secondary ms-1">@totalCount</span>
                                }
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isReadFilter == false ? "active" : "")" 
                               href="@Url.Action("Index", "Notification", new { isRead = false })">
                                <i class="fas fa-envelope"></i> Chưa đọc
                                @if (unreadCount > 0)
                                {
                                    <span class="badge bg-danger ms-1">@unreadCount</span>
                                }
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isReadFilter == true ? "active" : "")" 
                               href="@Url.Action("Index", "Notification", new { isRead = true })">
                                <i class="fas fa-envelope-open"></i> Đã đọc
                                @if (isReadFilter == true && totalCount > 0)
                                {
                                    <span class="badge bg-success ms-1">@totalCount</span>
                                }
                            </a>
                        </li>
                </ul>
            </div>

            <!-- Notifications List -->
            @if (Model.Any())
            {
                @foreach (var notification in Model)
                {
                    <div class="notification-card @(notification.IsRead ? "read" : "unread")" data-notification-id="@notification.Id">
                        <div class="d-flex align-items-start">
                            <div class="notification-icon @notification.Type.ToLower()">
                                <i class="fas @GetNotificationIcon(notification.Type)"></i>
                            </div>
                            <div class="notification-content">
                                <div class="notification-title">
                                    @notification.Title
                                    @if (!notification.IsRead)
                                    {
                                        <span class="badge bg-danger ms-2">Mới</span>
                                    }
                                </div>
                                <div class="notification-text">@notification.Content</div>
                                <div class="notification-meta">
                                    <span class="notification-time">
                                        <i class="fas fa-clock"></i> @notification.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                    <span class="notification-status @(notification.IsRead ? "read" : "unread")">
                                        @(notification.IsRead ? "Đã đọc" : "Chưa đọc")
                                    </span>
                                </div>
                            </div>
                            @if (!notification.IsRead)
                            {
                                <div class="notification-actions">
                                    <button class="btn mark-read-btn" data-notification-id="@notification.Id">
                                        <i class="fas fa-check"></i> Đã đọc
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-bell-slash"></i>
                    <h4>Không có thông báo</h4>
                    <p>
                        @if (isReadFilter == true)
                        {
                            <span>Bạn chưa có thông báo nào đã đọc.</span>
                        }
                        else if (isReadFilter == false)
                        {
                            <span>Bạn không có thông báo mới.</span>
                        }
                        else
                        {
                            <span>Bạn chưa có thông báo nào.</span>
                        }
                    </p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Mark single notification as read
            $('.mark-read-btn').click(function() {
                var notificationId = $(this).data('notification-id');
                var button = $(this);
                
                $.post('@Url.Action("MarkAsRead", "Notification")', { notificationId: notificationId })
                    .done(function(response) {
                        if (response.success) {
                            button.closest('.list-group-item').removeClass('bg-light');
                            button.closest('.list-group-item').find('h6').removeClass('fw-bold').addClass('text-muted');
                            button.closest('.list-group-item').find('.badge').remove();
                            button.replaceWith('<span class="text-success"><i class="fas fa-check-circle"></i></span>');
                            
                            // Update unread count
                            var unreadBadge = $('.nav-link[href*="isRead=false"] .badge');
                            var currentCount = parseInt(unreadBadge.text()) || 0;
                            if (currentCount > 1) {
                                unreadBadge.text(currentCount - 1);
                            } else {
                                unreadBadge.remove();
                            }
                        } else {
                            alert('Có lỗi xảy ra: ' + response.message);
                        }
                    })
                    .fail(function() {
                        alert('Có lỗi xảy ra khi đánh dấu đã đọc');
                    });
            });

            // Mark all as read
            $('#markAllReadBtn').click(function() {
                if (confirm('Bạn có chắc chắn muốn đánh dấu tất cả thông báo đã đọc?')) {
                    $.post('@Url.Action("MarkAllAsRead", "Notification")')
                        .done(function(response) {
                            if (response.success) {
                                location.reload();
                            } else {
                                alert('Có lỗi xảy ra: ' + response.message);
                            }
                        })
                        .fail(function() {
                            alert('Có lỗi xảy ra khi đánh dấu tất cả đã đọc');
                        });
                }
            });
        });
    </script>
}

@functions {
    string GetNotificationIcon(string type)
    {
        return type switch
        {
            "Order" => "fa-shopping-bag",
            "Payment" => "fa-money-bill",
            "Admin" => "fa-user-shield",
            "Shop" => "fa-store",
            "Product" => "fa-box",
            "System" => "fa-bell",
            _ => "fa-bell"
        };
    }

    string GetNotificationIconClass(string type)
    {
        return type switch
        {
            "Order" => "text-primary",
            "Payment" => "text-success",
            "Admin" => "text-info",
            "Shop" => "text-warning",
            "Product" => "text-secondary",
            "System" => "text-dark",
            _ => "text-muted"
        };
    }
}
