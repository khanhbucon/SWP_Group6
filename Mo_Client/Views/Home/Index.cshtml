@{
    ViewData["Title"] = "Trang chủ";
    var token = Context.Request.Cookies["accessToken"];
    var roles = Context.Request.Cookies["roles"];
}

<!-- Link CSS file -->
<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Hero Section with Search -->
<section class="hero-search-section">
    <div class="hero-overlay"></div>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="hero-content text-center mb-5">
                    <h1 class="hero-title text-white mb-3">Tìm Kiếm Sản Phẩm Số</h1>
                    <p class="hero-subtitle text-white-50">Khám phá hàng nghìn sản phẩm số chất lượng cao</p>
                </div>

                <!-- Search Form -->
                <div class="search-form-card shadow-lg">
                    <form id="searchForm" method="get" action="/Product/Index">
                        <div class="row g-3">
                            <!-- Category Filter -->
                            <div class="col-lg-4 col-md-6">
                                <select class="form-select search-input" id="categoryFilter" name="categoryId">
                                    <option value="">Tìm theo danh mục</option>
                                    <!-- Categories will be loaded dynamically -->
                                </select>
                            </div>

                            <!-- SubCategory Filter (optional, will be populated when category is selected) -->
                            <div class="col-lg-4 col-md-6">
                                <select class="form-select search-input" id="subCategoryFilter" name="subCategoryId" style="display: none;">
                                    <option value="">Tất cả danh mục con</option>
                                </select>
                            </div>

                            <!-- Search Button -->
                            <div class="col-lg-4 col-md-12">
                                <button type="submit" class="btn btn-search w-100">
                                    <i class="fas fa-search me-2"></i>Tìm kiếm
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

         
</section>

<!-- Featured Products Section -->
<!-- Category Tabs Section -->
<section class="category-tabs-section">
    <div class="container">
        <div class="section-header text-center mb-5">
            <h2 class="section-title">-- DANH SÁCH SẢN PHẨM --</h2>
            <p class="section-subtitle">Sản phẩm mới nhất và được quan tâm nhiều nhất</p>
        </div>

        <!-- Category Tabs -->

        <div id="categoryTabsContainer" class="category-tabs">
            <!-- Loading state -->
            <div class="text-center py-3">
                <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
                <span class="ms-2 text-muted">Đang tải danh mục...</span>
            </div>
        </div>

        <!-- Products Container -->
        <div id="productsContainer">
            <div class="loading-state">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Đang tải...</span>
                </div>
                <p class="mt-3 text-muted">Đang tải sản phẩm...</p>
            </div>
        </div>

        <!-- View All Button -->
        <div class="text-center mt-5">
            <a href="/Product/Index" class="btn btn-primary btn-lg">
                <i class="fas fa-th-large me-2"></i>Xem tất cả sản phẩm
            </a>
        </div>
    </div>
</section>

@section Scripts {
    <script>
                const API_BASE = 'https://localhost:7234/api';
        let allProducts = [];
        let allCategories = [];
        let allSubCategoriesGrouped = [];
        let currentCategory = 'all';

        // Category mapping
                // Icon mapping for categories
        const categoryIcons = {
            'game': 'fas fa-gamepad',
            'gift': 'fas fa-gift',
            'premium': 'fas fa-crown',
            'phone': 'fas fa-mobile-alt',
            'social': 'fas fa-share-alt',
            'netflix': 'fas fa-film',
            'spotify': 'fas fa-music',
            'youtube': 'fab fa-youtube',
            'facebook': 'fab fa-facebook',
            'card': 'fas fa-credit-card',
            'account': 'fas fa-user-circle',
            'default': 'fas fa-tag'
        };

        // Get icon for category
        function getCategoryIcon(categoryName) {
            const name = categoryName.toLowerCase();

            for (const [key, icon] of Object.entries(categoryIcons)) {
                if (name.includes(key)) {
                    return icon;
                }
            }

            return categoryIcons.default;
        }

        // Load categories and render tabs
        async function loadCategoryTabs() {
            try {
                const response = await fetch(`${API_BASE}/Category/all`);
                if (response.ok) {
                    const data = await response.json();
                    if (data.success && data.data) {
                        allCategories = data.data;
                        renderCategoryTabs(data.data);

                        // Also populate category filter
                        populateCategoryFilter(data.data);
                    } else {
                        showCategoryTabsError();
                    }
                } else {
                    showCategoryTabsError();
                }
            } catch (error) {
                console.error('Error loading categories:', error);
                showCategoryTabsError();
            }
        }

        // Render category tabs dynamically
        function renderCategoryTabs(categories) {
            const container = document.getElementById('categoryTabsContainer');

            if (categories.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-3 text-muted">
                        <i class="fas fa-inbox me-2"></i>Chưa có danh mục nào
                    </div>
                `;
                return;
            }

            // Build tabs HTML
            let tabsHTML = `
                <a href="#" class="category-tab active" data-category="all" data-category-id="">
                    <i class="fas fa-th-large"></i>
                    <span>Tất cả</span>
                </a>
            `;

            categories.forEach(cat => {
                const icon = getCategoryIcon(cat.name);
                tabsHTML += `
                    <a href="#" class="category-tab" data-category="${cat.name.toLowerCase()}" data-category-id="${cat.id}">
                        <i class="${icon}"></i>
                        <span>${cat.name}</span>
                    </a>
                `;
            });

            container.innerHTML = tabsHTML;

            // Attach click handlers
            attachCategoryTabHandlers();
        }

        // Show error state for category tabs
        function showCategoryTabsError() {
            const container = document.getElementById('categoryTabsContainer');
            container.innerHTML = `
                <div class="text-center py-3">
                    <span class="text-danger">
                        <i class="fas fa-exclamation-circle me-2"></i>Không thể tải danh mục
                    </span>
                    <button class="btn btn-sm btn-outline-primary ms-3" onclick="loadCategoryTabs()">
                        <i class="fas fa-redo me-1"></i>Thử lại
                    </button>
                </div>
            `;
        }

        // Populate category filter dropdown
        function populateCategoryFilter(categories) {
            const select = document.getElementById('categoryFilter');

            // Clear existing options except first one
            select.innerHTML = '<option value="">Tìm theo danh mục</option>';

            categories.forEach(cat => {
                const option = document.createElement('option');
                option.value = cat.id;
                option.textContent = cat.name;
                select.appendChild(option);
            });

            // Add event listener for category change to load subcategories
            select.addEventListener('change', function() {
                const categoryId = this.value;
                const subCategorySelect = document.getElementById('subCategoryFilter');
                
                if (categoryId) {
                    loadSubCategories(categoryId);
                    subCategorySelect.style.display = 'block';
                } else {
                    subCategorySelect.style.display = 'none';
                    subCategorySelect.innerHTML = '<option value="">Tất cả danh mục con</option>';
                }
            });
        }

        // Load subcategories for selected category
        async function loadSubCategories(categoryId) {
            const subCategorySelect = document.getElementById('subCategoryFilter');
            subCategorySelect.innerHTML = '<option value="">Tất cả danh mục con</option>';
            
            // If we already have grouped data, use it
            if (allSubCategoriesGrouped.length > 0) {
                const categoryGroup = allSubCategoriesGrouped.find(g => g.categoryId == categoryId);
                if (categoryGroup && categoryGroup.subCategories && categoryGroup.subCategories.length > 0) {
                    categoryGroup.subCategories.forEach(subCat => {
                        const option = document.createElement('option');
                        option.value = subCat.id;
                        option.textContent = subCat.name;
                        subCategorySelect.appendChild(option);
                    });
                }
                return;
            }
            
            // Otherwise, load from API
            try {
                const response = await fetch(`${API_BASE}/SubCategory/grouped`);
                if (response.ok) {
                    const data = await response.json();
                    if (data.success && data.data) {
                        allSubCategoriesGrouped = data.data;
                        const categoryGroup = allSubCategoriesGrouped.find(g => g.categoryId == categoryId);
                        if (categoryGroup && categoryGroup.subCategories && categoryGroup.subCategories.length > 0) {
                            categoryGroup.subCategories.forEach(subCat => {
                                const option = document.createElement('option');
                                option.value = subCat.id;
                                option.textContent = subCat.name;
                                subCategorySelect.appendChild(option);
                            });
                        }
                    }
                }
            } catch (error) {
                console.error('Error loading subcategories:', error);
            }
        }

        // Attach event handlers to category tabs
        function attachCategoryTabHandlers() {
            document.querySelectorAll('.category-tab').forEach(tab => {
                tab.addEventListener('click', function(e) {
                    e.preventDefault();

                    // Remove active class from all tabs
                    document.querySelectorAll('.category-tab').forEach(t => t.classList.remove('active'));

                    // Add active class to clicked tab
                    this.classList.add('active');

                    // Get category and render products
                    const categoryId = this.dataset.categoryId;
                    const categoryName = this.dataset.category;

                    console.log('Category tab clicked:', {
                        categoryId: categoryId,
                        categoryName: categoryName,
                        dataset: this.dataset
                    });

                    currentCategory = categoryName;

                    if (categoryId && categoryId.trim() !== '') {
                        // Filter by category ID
                        const catId = parseInt(categoryId);
                        console.log('Filtering by category ID:', catId);
                        renderProductsByCategory(catId);
                    } else {
                        // Show all products
                        console.log('Showing all products');
                        renderProducts(allProducts, 'Tất cả sản phẩm');
                    }
                });
            });
        }

        // Render products by category ID
        function renderProductsByCategory(categoryId) {
            console.log('Filtering products by categoryId:', categoryId);
            console.log('All products count:', allProducts.length);
            console.log('Sample product:', allProducts[0]);
            
            // Get category info
            const category = allCategories.find(c => c.id === categoryId);
            const categoryName = category ? category.name : 'Sản phẩm';
            console.log('Category name:', categoryName);
            
            // Filter products - try multiple approaches
            let filteredProducts = allProducts.filter(product => {
                // Try categoryId (PascalCase or camelCase)
                const prodCatId = product.categoryId || product.CategoryId;
                if (prodCatId === categoryId) {
                    return true;
                }
                
                // Try subCategoryId (in case categoryId is actually subCategoryId)
                const prodSubCatId = product.subCategoryId || product.SubCategoryId;
                if (prodSubCatId === categoryId) {
                    return true;
                }
                
                // Try categoryName match
                const prodCatName = (product.categoryName || product.CategoryName || '').toLowerCase();
                const catName = categoryName.toLowerCase();
                if (prodCatName === catName) {
                    return true;
                }
                
                return false;
            });
            
            console.log('Filtered products count:', filteredProducts.length);
            
            // If no products found, try loading products filtered by category from API
            if (filteredProducts.length === 0) {
                console.log('No products found with local filter, trying API...');
                loadProductsByCategory(categoryId, categoryName);
            } else {
                renderProducts(filteredProducts, categoryName);
            }
        }
        
        // Load products filtered by category from API
        async function loadProductsByCategory(categoryId, categoryName) {
            try {
                const response = await fetch(`${API_BASE}/product/GetAllProducts?page=1&pageSize=100&categoryId=${categoryId}`);
                if (response.ok) {
                    const data = await response.json();
                    if (data.success && data.data) {
                        console.log('Products from API for category:', data.data.length);
                        renderProducts(data.data, categoryName);
                    } else {
                        renderProducts([], categoryName);
                    }
                } else {
                    renderProducts([], categoryName);
                }
            } catch (error) {
                console.error('Error loading products by category:', error);
                renderProducts([], categoryName);
            }
        }

        // Load all products
        async function loadProducts() {
            try {
                const response = await fetch(`${API_BASE}/product/GetAllProducts?page=1&pageSize=100`);
                if (response.ok) {
                    const data = await response.json();
                    if (data.success && data.data) {
                        allProducts = data.data;
                        renderProducts(data.data, 'Tất cả sản phẩm');
                    } else {
                        showEmptyState();
                    }
                } else {
                    showErrorState();
                }
            } catch (error) {
                console.error('Error loading products:', error);
                showErrorState();
            }
        }

        // Render products
        function renderProducts(products, categoryName = 'Tất cả sản phẩm') {
            const container = document.getElementById('productsContainer');

            if (products.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <i class="fas fa-inbox"></i>
                        <h4>Không có sản phẩm nào</h4>
                        <p class="text-muted">Danh mục này hiện chưa có sản phẩm</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = `
                <div class="category-header">
                    <h3>${categoryName}</h3>
                    <p>Hiển thị ${products.length} sản phẩm</p>
                </div>
                <div class="row g-4">
                    ${products.slice(0, 12).map(product => `
                        <div class="col-lg-3 col-md-4 col-sm-6">
                            <div class="product-card">
                                ${product.image ?
                                    `<img src="data:image/jpeg;base64,${product.image}" class="card-img-top" alt="${product.name}">` :
                                    `<div class="product-placeholder">
                                        <i class="fas fa-image fa-3x text-white"></i>
                                    </div>`
                                }
                                <div class="card-body">
                                    <h6 class="card-title text-truncate" title="${product.name}">${product.name}</h6>
                                    <p class="shop-name mb-3">
                                        <i class="fas fa-store me-1"></i>${product.shopName || 'N/A'}
                                    </p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="price">${(product.minPrice || 0).toLocaleString('vi-VN')} ₫</div>
                                        <a href="/Product/View/${product.id}" class="btn btn-view btn-sm">
                                            <i class="fas fa-eye me-1"></i>Xem
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `).join('')}
                </div>
            `;
        }

        function showEmptyState() {
            document.getElementById('productsContainer').innerHTML = `
                <div class="empty-state">
                    <i class="fas fa-box-open"></i>
                    <h4>Chưa có sản phẩm nào</h4>
                    <p class="text-muted">Hệ thống hiện chưa có sản phẩm để hiển thị</p>
                </div>
            `;
        }

        function showErrorState() {
            document.getElementById('productsContainer').innerHTML = `
                <div class="empty-state">
                    <i class="fas fa-exclamation-triangle text-warning"></i>
                    <h4>Không thể tải sản phẩm</h4>
                    <p class="text-muted">Vui lòng thử lại sau</p>
                    <button class="btn btn-primary mt-3" onclick="loadProducts()">
                        <i class="fas fa-redo me-2"></i>Thử lại
                    </button>
                </div>
            `;
        }

        // Category tab click handler
        document.addEventListener('DOMContentLoaded', function() {
            // Load category tabs first
            loadCategoryTabs();

            // Then load products
            loadProducts();
            
            // Preload subcategories grouped data
            fetch(`${API_BASE}/SubCategory/grouped`)
                .then(r => r.json())
                .then(data => {
                    if (data.success && data.data) {
                        allSubCategoriesGrouped = data.data;
                    }
                })
                .catch(err => console.error('Error preloading subcategories:', err));
        });
    </script>
}