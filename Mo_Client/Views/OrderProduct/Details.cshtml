@model Mo_Entities.Models.Response.OrderProductRp

@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng";
}

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Chi Tiết Đơn Hàng</h4>
        </div>
        <div class="card-body p-4">

            <dl class="row">
                <dt class="col-sm-3 text-secondary">Mã đơn hàng</dt>
                <dd class="col-sm-9 fw-semibold">@Model.Id</dd>

                <dt class="col-sm-3 text-secondary">Tài khoản</dt>
                <dd class="col-sm-9 fw-semibold text-dark">@Model.AccountName</dd>

                <dt class="col-sm-3 text-secondary">Sản phẩm</dt>
                <dd class="col-sm-9 fw-semibold text-dark">@Model.ProductName</dd>

                <dt class="col-sm-3 text-secondary">Số lượng</dt>
                <dd class="col-sm-9">@Model.Quantity</dd>

                <dt class="col-sm-3 text-secondary">Tổng tiền</dt>
                <dd class="col-sm-9 text-success fw-bold">@Model.TotalAmount.ToString("N0") VNĐ</dd>

                <dt class="col-sm-3 text-secondary">Trạng thái</dt>
                <dd class="col-sm-9">
                    @if (Model.Status.ToUpper() == "CONFIRMED")
                    {
                        <span class="badge bg-success px-3 py-2">Đã xác nhận</span>
                    }
                    else if (Model.Status.ToUpper() == "PENDING")
                    {
                        <span class="badge bg-warning text-dark px-3 py-2">Đang chờ</span>
                    }
                    else if (Model.Status.ToUpper() == "CANCELLED")
                    {
                        <span class="badge bg-danger px-3 py-2">Đã hủy</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary px-3 py-2">@Model.Status</span>
                    }
                </dd>
            </dl>

            <div class="mt-4 text-end">
                <a asp-action="Index" class="btn btn-outline-secondary">← Quay lại danh sách</a>
            </div>
        </div>
    </div>
</div>
