@model List<Mo_Client.Models.ClientPaymentHistoryVm>
@{
    ViewData["Title"] = "Lịch sử nạp tiền";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Lịch sử nạp tiền</h4>
                </div>
                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Mã giao dịch</th>
                                        <th>Số tiền</th>
                                        <th>Ngân hàng</th>
                                        <th>Trạng thái</th>
                                        <th>Ngày tạo</th>
                                        <th>Nội dung</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.TransactionId</td>
                                            <td>@item.Amount.ToString("N0") VNĐ</td>
                                            <td>@item.BankName</td>
                                            <td>
                                                <span class="badge @(item.Status == "COMPLETED" ? "bg-success" : item.Status == "PENDING" ? "bg-warning" : "bg-danger")">
                                                    @item.Status
                                                </span>
                                            </td>
                                            <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@item.Content</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <p class="text-muted">Chưa có giao dịch nạp tiền nào</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
