@model Mo_Client.Models.ClientPaymentBalanceVm
@{
    ViewData["Title"] = "Số dư tài khoản";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Số dư tài khoản</h4>
                </div>
                <div class="card-body text-center">
                    <div class="mb-3">
                        <h2 class="text-primary">@Model.Balance.ToString("N0") VNĐ</h2>
                    </div>
                    <p class="text-muted">Tài khoản: @Model.Username</p>
                    
                    <div class="mt-4">
                        <a href="@Url.Action("Deposit", "Payment")" class="btn btn-primary me-2">
                            <i class="fas fa-plus"></i> Nạp tiền
                        </a>
                        <a href="@Url.Action("History", "Payment")" class="btn btn-outline-secondary">
                            <i class="fas fa-history"></i> Lịch sử
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
