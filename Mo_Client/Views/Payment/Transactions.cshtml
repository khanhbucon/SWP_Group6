@model List<Mo_Client.Models.ClientPaymentTransactionVm>
@{
    ViewData["Title"] = "Lịch sử giao dịch";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Lịch sử giao dịch</h4>
                    <div>
                        <a href="@Url.Action("Deposit", "Payment")" class="btn btn-primary btn-sm">
                            <i class="fas fa-plus"></i> Nạp tiền
                        </a>
                        <a href="@Url.Action("Balance", "Payment")" class="btn btn-outline-info btn-sm">
                            <i class="fas fa-wallet"></i> Số dư
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Loại giao dịch</th>
                                        <th>Số tiền</th>
                                        <th>Mô tả</th>
                                        <th>Trạng thái</th>
                                        <th>Ngày tạo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.Id</td>
                                            <td>
                                                <span class="badge @(item.Type == "DEPOSIT" ? "bg-success" : "bg-info")">
                                                    @item.Type
                                                </span>
                                            </td>
                                            <td>@item.Amount.ToString("N0") VNĐ</td>
                                            <td>@item.PaymentDescription</td>
                                            <td>
                                                <span class="badge @(item.Status == "COMPLETED" ? "bg-success" : item.Status == "PENDING" ? "bg-warning" : "bg-danger")">
                                                    @item.Status
                                                </span>
                                            </td>
                                            <td>@item.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <p class="text-muted">Chưa có giao dịch nào</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
