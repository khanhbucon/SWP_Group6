@model Mo_Client.Controllers.ProductController.EditProductVm
@{ Layout = "~/Views/Seller/_SellerLayout.cshtml"; ViewData["Title"] = "Sửa sản phẩm"; }
<h4 class="mb-3"><i class="fas fa-edit text-primary me-2"></i>Sửa sản phẩm</h4>
<form asp-action="Edit" method="post" class="card shadow-sm border-0 p-4" enctype="multipart/form-data">
  <input asp-for="Id" type="hidden" />
  <input asp-for="NewImageBase64" type="hidden" />
  <div class="mb-3">
    <label class="form-label">Tên</label>
    <input asp-for="Name" class="form-control" />
  </div>
  <div class="mb-3">
    <label class="form-label">Mô tả ngắn</label>
    <input asp-for="ShortDescription" class="form-control" />
  </div>
  <div class="mb-3">
    <label class="form-label">Chi tiết</label>
    <textarea asp-for="DetailedDescription" class="form-control" rows="6"></textarea>
  </div>

  <div class="row g-4 mb-3">
    <div class="col-md-6">
      <label class="form-label">Ảnh hiện tại</label>
      <div>
        @if (!string.IsNullOrEmpty(Model.CurrentImageUrl))
        {
          <img id="currentImage" src="@Model.CurrentImageUrl" onerror="this.src='/images/no-image.png'" style="max-width:220px;max-height:220px;border:1px solid #eee;border-radius:8px;object-fit:cover" />
        }
        else
        {
          <img id="currentImage" src="/images/no-image.png" style="max-width:220px;max-height:220px;border:1px solid #eee;border-radius:8px;object-fit:cover" />
        }
      </div>
      <div class="form-check mt-2">
        <input class="form-check-input" asp-for="RemoveImage" id="removeImageChk" />
        <label class="form-check-label" for="removeImageChk">Xóa ảnh</label>
      </div>
      <small class="text-muted d-block">Ảnh mới sẽ thay thế ảnh hiện tại. Nếu chọn Xóa ảnh, hệ thống sẽ bỏ ảnh sản phẩm.</small>
    </div>
    <div class="col-md-6">
      <label class="form-label">Tải ảnh mới</label>
      <input id="fileInput" type="file" accept="image/*" class="form-control" />
      <div class="mt-2">
        <img id="preview" style="display:none;max-width:220px;max-height:220px;border:1px dashed #ccc;border-radius:8px;object-fit:cover" />
      </div>
    </div>
  </div>

  <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Phí sàn (5%)</label>
            <input asp-for="Fee" class="form-control" readonly />
        </div>
    <div class="col-md-4">
      <label class="form-label">Kích hoạt</label>
          <select asp-for="IsActive" class="form-select">
            <option value="">-- Giữ nguyên --</option>
            <option value="true">Hoạt Động</option>
            <option value="false">Ngưng</option>
          </select>
    </div>
  </div>
  <div class="mt-4 d-flex gap-2">
    <button class="btn btn-primary"><i class="fas fa-save me-1"></i>Lưu</button>
        <a asp-action="List" class="btn btn-outline-secondary">Quay Lại </a>
       
  </div>
</form>

@section Scripts{
<script>
  const fileInput = document.getElementById('fileInput');
  const preview = document.getElementById('preview');
  const hiddenBase64 = document.querySelector('input[name="NewImageBase64"]');
  const removeChk = document.getElementById('removeImageChk');

  fileInput.addEventListener('change', function(){
    const file = this.files && this.files[0];
    if(!file){ preview.style.display = 'none'; hiddenBase64.value=''; return; }
    const reader = new FileReader();
    reader.onload = function(e){
      const dataUrl = e.target.result;
      preview.src = dataUrl;
      preview.style.display = 'block';
      hiddenBase64.value = dataUrl; // send data URL to server
      if(removeChk) removeChk.checked = false; // uncheck remove if uploading new image
    };
    reader.readAsDataURL(file);
  });

  if(removeChk){
    removeChk.addEventListener('change', function(){
      if(this.checked){
        // clear any uploaded image
        hiddenBase64.value='';
        if(preview){ preview.src=''; preview.style.display='none'; }
      }
    });
  }
</script>
}
