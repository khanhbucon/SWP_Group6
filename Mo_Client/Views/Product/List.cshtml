@model List<Mo_Client.Services.AuthApiClient.ProductSummary>
@{ Layout = "~/Views/Seller/_SellerLayout.cshtml"; ViewData["Title"] = "Sản phẩm"; }
@if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>}
@if(TempData["Error"]!=null){<div class="alert alert-danger">@TempData["Error"]</div>}

<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="mb-0"><i class="fas fa-box text-primary me-2"></i>Sản phẩm của tôi</h4>
  <div class="d-flex" style="gap:.5rem; max-width:600px; width:100%; justify-content:flex-end;">
    <form method="get" asp-action="List" class="d-flex" style="max-width:420px;width:100%">
      <input type="text" name="search" value="@Context.Request.Query["search"]" class="form-control me-2" placeholder="Tìm theo tên hoặc mô tả..." />
      <button class="btn btn-primary"><i class="fas fa-search me-1"></i>Tìm</button>
    </form>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="bg-light">
          <tr>
            <th class="px-4 py-3" style="width: 5%">#</th>
            <th class="py-3" style="width: 20%">Tên</th>
            <th class="py-3" style="width: 25%">Mô tả ngắn</th>
            <th class="py-3" style="width: 12%">Shop</th>
            <th class="py-3 text-center" style="width: 10%">Trạng thái</th>
            <th class="py-3 text-end px-4" style="width: 28%">Thao tác</th>
          </tr>
        </thead>
        <tbody>
        @if(Model==null || !Model.Any()){
          <tr><td colspan="6" class="text-center text-muted py-5"><i class="fas fa-inbox fa-2x mb-3 d-block"></i>Chưa có sản phẩm nào</td></tr>
        } else {
          var page = (int)(ViewBag.Page ?? 1);
          var pageSize = (int)(ViewBag.PageSize ?? 10);
          var startIndex = (page - 1) * pageSize + 1;
          var i=0; foreach(var p in Model){
            var isPending = p.IsActive == null;
            <tr class="border-bottom">
              <td class="px-4 fw-medium text-muted">@(startIndex + i)</td>
              <td class="fw-semibold">@p.Name</td>
              <td class="text-muted" style="max-width:250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@p.Description</td>
              <td><span class="badge bg-light text-dark border">@p.ShopName</span></td>
              <td class="text-center">
                @if(isPending){
                  <span class="badge bg-warning text-dark px-2 py-1"><i class="fas fa-hourglass-half me-1"></i>Chờ duyệt</span>
                } else if(p.IsActive==true){
                  <span class="badge bg-success px-2 py-1"><i class="fas fa-check-circle me-1"></i>Hoạt động</span>
                } else {
                  <span class="badge bg-danger px-2 py-1"><i class="fas fa-times-circle me-1"></i>Ngưng</span>
                }
              </td>
              <td class="text-end px-4">
                <div class="d-flex flex-column gap-1 align-items-end">
                  <div class="btn-group btn-group-sm" role="group">
                    <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-primary" title="Chi tiết">
                      <i class="fas fa-eye"></i>
                    </a>
                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-outline-secondary @(isPending ? "disabled" : string.Empty)" title="Sửa">
                      <i class="fas fa-edit"></i>
                    </a>
                    <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Xoá sản phẩm này?');">
                      @Html.AntiForgeryToken()
                      <button type="submit" class="btn btn-outline-danger" title="Xoá">
                        <i class="fas fa-trash"></i>
                      </button>
                    </form>
                  </div>
                  <a asp-action="BulkUploadForProduct" asp-route-productId="@p.Id" class="btn btn-sm btn-success @(isPending ? "disabled" : string.Empty)" title="Tải lên .txt cho sản phẩm này">
                    <i class="fas fa-file-upload me-1"></i>Tải lên .txt
                  </a>
                  @if(isPending){
                    <small class="text-muted"><i class="fas fa-info-circle me-1"></i>Sản phẩm đang chờ Admin duyệt</small>
                  }
                </div>
              </td>
            </tr>
            i++; 
          }
        }
        </tbody>
      </table>
    </div>
  </div>
</div>

@{
  var totalPages = (int)(ViewBag.TotalPages ?? 1);
  var currentPage = (int)(ViewBag.Page ?? 1);
  var search = Context.Request.Query["search"].ToString();
}
@if(totalPages > 1){
  <nav class="mt-3">
    <ul class="pagination mb-0">
      <li class="page-item @(currentPage==1?"disabled":"")">
        <a class="page-link" asp-action="List" asp-route-page="@(currentPage-1)" asp-route-search="@search">«</a>
      </li>
      @for(int p = 1; p <= totalPages; p++){
        <li class="page-item @(p==currentPage?"active":"")">
          <a class="page-link" asp-action="List" asp-route-page="@p" asp-route-search="@search">@p</a>
        </li>
      }
      <li class="page-item @(currentPage==totalPages?"disabled":"")">
        <a class="page-link" asp-action="List" asp-route-page="@(currentPage+1)" asp-route-search="@search">»</a>
      </li>
    </ul>
  </nav>
}
