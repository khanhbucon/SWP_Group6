@model List<Mo_Client.Services.AuthApiClient.ProductSummary>
@{
    Layout = "~/Views/Seller/_SellerLayout.cshtml";
    ViewData["Title"] = "Sản phẩm";
    var accessToken = ViewBag.AccessToken as string;
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="fas fa-box text-primary me-2"></i>Sản phẩm của tôi</h4>
    <div class="d-flex" style="gap:.5rem; max-width:600px; width:100%; justify-content:flex-end;">
        <form method="get" asp-action="List" class="d-flex" style="max-width:420px;width:100%">
            <input type="text" name="search" value="@Context.Request.Query["search"]" class="form-control me-2" placeholder="Tìm theo tên hoặc mô tả..." />
            <button class="btn btn-primary"><i class="fas fa-search me-1"></i>Tìm</button>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="px-4 py-3" style="width: 5%">#</th>
                        <th class="py-3" style="width: 10%">Ảnh</th>
                        <th class="py-3" style="width: 20%">Tên</th>
                        <th class="py-3" style="width: 25%">Mô tả ngắn</th>
                        <th class="py-3" style="width: 12%">Shop</th>
                        <th class="py-3 text-center" style="width: 10%">Trạng thái</th>
                        <th class="py-3 text-end px-4" style="width: 18%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-5"><i class="fas fa-inbox fa-2x mb-3 d-block"></i>Chưa có sản phẩm nào</td></tr>
                    }
                    else
                    {
                        var page = (int)(ViewBag.Page ?? 1);
                        var pageSize = (int)(ViewBag.PageSize ?? 10);
                        var startIndex = (page - 1) * pageSize + 1;
                        string apiBase = (ViewBag.ApiBase as string) ?? string.Empty;
                        var i = 0;
                        foreach (var p in Model)
                        {
                            var imgUrl = string.IsNullOrEmpty(apiBase) ? string.Empty : $"{apiBase}/api/product/{p.Id}/image";
                            var isPending = p.IsActive == null;
                            <tr class="border-bottom">
                                <td class="px-4 fw-medium text-muted">@(startIndex + i)</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(imgUrl))
                                    {
                                        <img src="@imgUrl" alt="@p.Name" onerror="this.onerror=null;this.src='/images/no-image.png';" style="width:60px;height:60px;object-fit:cover;border-radius:6px;border:1px solid #eee;" />
                                    }
                                    else
                                    {
                                        <div style="width:60px;height:60px;background:#f5f5f7;border:1px solid #eee;border-radius:6px;display:flex;align-items:center;justify-content:center;color:#bbb;">
                                            <i class="fas fa-image"></i>
                                        </div>
                                    }
                                </td>
                                <td class="fw-semibold">@p.Name</td>
                                <td class="text-muted" style="max-width:250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@p.Description</td>
                                <td><span class="badge bg-light text-dark border">@p.ShopName</span></td>
                                <td class="text-center">
                                    @if (isPending)
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1"><i class="fas fa-hourglass-half me-1"></i>Chờ duyệt</span>
                                    }
                                    else if (p.IsActive == true)
                                    {
                                        <span class="badge bg-success px-2 py-1"><i class="fas fa-check-circle me-1"></i>Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger px-2 py-1"><i class="fas fa-times-circle me-1"></i>Ngưng</span>
                                    }
                                </td>
                                <td class="text-end px-4">
                                    <div class="d-flex flex-column gap-1 align-items-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-primary" title="Chi tiết">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-outline-secondary @(isPending ? "disabled" : string.Empty)" title="Sửa">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        </div>

                                        @if (isPending)
                                        {
                                            <div class="btn-group btn-group-sm mt-1" role="group">
                                                <button class="btn btn-outline-success disabled" disabled title="Đang chờ duyệt">
                                                    <i class="fas fa-check-circle"></i> Bật
                                                </button>
                                                <button class="btn btn-outline-danger disabled" disabled title="Đang chờ duyệt">
                                                    <i class="fas fa-pause-circle"></i> Tắt
                                                </button>
                                            </div>
                                            <small class="text-muted"><i class="fas fa-info-circle me-1"></i>Chờ Admin duyệt</small>
                                        }
                                        else
                                        {
                                            <div class="btn-group btn-group-sm mt-1" role="group">
                                                @if (p.IsActive == false)
                                                {
                                                    <button class="btn btn-outline-success toggle-status-btn"
                                                            data-product-id="@p.Id"
                                                            data-action="activate"
                                                            title="Bật sản phẩm">
                                                        <i class="fas fa-check-circle"></i> Bật
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-outline-success disabled" disabled>
                                                        <i class="fas fa-check-circle"></i> Đang bật
                                                    </button>
                                                }

                                                @if (p.IsActive == true)
                                                {
                                                    <button class="btn btn-outline-danger toggle-status-btn"
                                                            data-product-id="@p.Id"
                                                            data-action="deactivate"
                                                            title="Tắt sản phẩm">
                                                        <i class="fas fa-pause-circle"></i> Tắt
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-outline-danger disabled" disabled>
                                                        <i class="fas fa-pause-circle"></i> Đang tắt
                                                    </button>
                                                }
                                            </div>
                                        }

                                        <a asp-action="BulkUploadForProduct" asp-route-productId="@p.Id"
                                           class="btn btn-sm btn-success mt-1 @(isPending ? "disabled" : string.Empty)"
                                           title="Tải lên .txt cho sản phẩm này">
                                            <i class="fas fa-file-upload me-1"></i>Tải lên .txt
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@{
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var currentPage = (int)(ViewBag.Page ?? 1);
    var search = Context.Request.Query["search"].ToString();
}
@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination mb-0">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="List" asp-route-page="@(currentPage - 1)" asp-route-search="@search">«</a>
            </li>
            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="List" asp-route-page="@p" asp-route-search="@search">@p</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="List" asp-route-page="@(currentPage + 1)" asp-route-search="@search">»</a>
            </li>
        </ul>
    </nav>
}

@section Scripts {
    <script>
        const API_BASE = '@(ViewBag.ApiBase ?? "https://localhost:7234")';
        const ACCESS_TOKEN = '@Html.Raw(accessToken ?? "")';

        // Get access token - now from ViewBag instead of cookie
        function getAccessToken() {
            console.log('=== Getting Access Token ===');

            if (ACCESS_TOKEN && ACCESS_TOKEN.length > 0) {
                console.log('✅ Token from server:', ACCESS_TOKEN.substring(0, 30) + '...');
                return ACCESS_TOKEN;
            }

            console.log('Trying cookie fallback...');
            const cookies = document.cookie.split('; ');
            const tokenCookie = cookies.find(row => row.startsWith('accessToken='));

            if (tokenCookie) {
                const token = tokenCookie.split('=')[1];
                console.log('✅ Token from cookie:', token.substring(0, 30) + '...');
                return token;
            }

            console.error('❌ No token available');
            return null;
        }

        // Toggle product status
        async function toggleProductStatus(productId, isActive) {
            console.log('=== Toggle Product Status ===');
            console.log('Product ID:', productId);
            console.log('Set Active:', isActive);

            const token = getAccessToken();

            if (!token) {
                console.error('❌ No token');
                alert('Phiên đăng nhập đã hết hạn.\n\nVui lòng đăng nhập lại.');
                window.location.href = '/Account/Login';
                return;
            }

            try {
                const url = `${API_BASE}/api/Product/${productId}/toggle-status?isActive=${isActive}`;
                console.log('API URL:', url);

                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    }
                });

                console.log('Status:', response.status);

                if (response.status === 401) {
                    console.error('❌ 401 Unauthorized');
                    alert('Phiên đăng nhập đã hết hạn.\n\nVui lòng đăng nhập lại.');
                    window.location.href = '/Account/Login';
                    return;
                }

                if (response.status === 403) {
                    console.error('❌ 403 Forbidden');
                    alert('Bạn không có quyền thay đổi sản phẩm này.');
                    return;
                }

                const data = await response.json();
                console.log('Response:', data);

                if (response.ok && data.success) {
                    console.log('✅ Success');

                    const alertDiv = document.createElement('div');
                    alertDiv.className = 'alert alert-success alert-dismissible fade show';
                    alertDiv.innerHTML = `
                        <i class="fas fa-check-circle me-2"></i>${data.message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    `;

                    document.querySelector('.card')?.insertAdjacentElement('beforebegin', alertDiv);
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    console.error('❌ Error:', data.message);
                    alert(data.message || 'Có lỗi xảy ra');
                }
            } catch (error) {
                console.error('❌ Exception:', error);
                alert('Lỗi kết nối: ' + error.message);
            }
        }

        // Attach listeners
        document.addEventListener('DOMContentLoaded', function () {
            console.log('=== Page Loaded ===');
            console.log('API Base:', API_BASE);
            console.log('Has Token:', !!ACCESS_TOKEN);

            const buttons = document.querySelectorAll('.toggle-status-btn');
            console.log('Buttons:', buttons.length);

            buttons.forEach(btn => {
                btn.addEventListener('click', function () {
                    const productId = this.dataset.productId;
                    const action = this.dataset.action;
                    const isActive = action === 'activate';

                    const msg = isActive ? 'BẬT' : 'TẮT';
                    if (confirm(`Bạn có chắc muốn ${msg} sản phẩm này?`)) {
                        toggleProductStatus(productId, isActive);
                    }
                });
            });

            console.log('Ready');
        });
    </script>
}