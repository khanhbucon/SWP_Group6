@model Mo_Client.Controllers.ProductController.PublicProductDetailData
@{
    ViewData["Title"] = Model.Name;
    var isLoggedIn = ViewBag.IsLoggedIn ?? false;
}

@Html.AntiForgeryToken()

<div class="container mt-5 pt-4">
    <div class="row">
        <!-- Product Image -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0" style="border-radius: 12px;">
                @if (!string.IsNullOrEmpty(Model.Image))
                {
                    <img src="data:image/jpeg;base64,@Model.Image" class="card-img-top" alt="@Model.Name"
                         style="max-height: 500px; object-fit: contain; border-radius: 12px;">
                }
                else
                {
                    <div class="text-center p-5 bg-light" style="min-height: 400px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="fas fa-image fa-5x text-muted"></i>
                    </div>
                }
            </div>
        </div>

        <!-- Product Info -->
        <div class="col-md-6">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Product/Index">Sản phẩm</a></li>
                    <li class="breadcrumb-item">@Model.CategoryName</li>
                    <li class="breadcrumb-item active">@Model.Name</li>
                </ol>
            </nav>

            <!-- Product Title & Badges -->
            <div class="d-flex align-items-center mb-3">
                <span class="badge bg-success me-2 px-3 py-2">SẢN PHẨM</span>
                <h4 class="mb-0 fw-bold">@Model.Name</h4>
            </div>

            <!-- Rating & Stats (có thể thêm sau) -->
            <div class="mb-3 d-flex align-items-center">
                <div class="text-warning me-3">
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star-half-alt"></i>
                    <span class="text-muted ms-2">(0 Reviews)</span>
                </div>
                <span class="text-muted">| Đã bán: <strong>@Model.TotalSold</strong></span>
                <span class="text-muted ms-3">| Kho: <strong class="@(Model.TotalStock > 0 ? "text-success" : "text-danger")">@Model.TotalStock</strong></span>
            </div>

            <!-- Shop Info -->
            <div class="card mb-3 border-0 bg-light">
                <div class="card-body py-2">
                    <small>
                        <strong>Người bán:</strong>
                        <span class="text-primary">@(!string.IsNullOrEmpty(Model.ShopName) ? Model.ShopName : "Chưa có thông tin")</span>
                        @if (!string.IsNullOrEmpty(Model.ShopName))
                        {
                            <span class="badge bg-success ms-2"><i class="fas fa-check-circle"></i> Đã xác thực</span>
                        }
                    </small>
                </div>
            </div>

            <!-- Category -->
            <div class="mb-3">
                <small>
                    <strong>Sản phẩm:</strong> 
                    @if (!string.IsNullOrEmpty(Model.SubCategoryName))
                    {
                        @if (Model.SubCategoryId.HasValue)
                        {
                            <a href="/Product/Index?subCategoryId=@Model.SubCategoryId" class="text-decoration-none">@Model.SubCategoryName</a>
                        }
                        else
                        {
                            <span class="text-decoration-none">@Model.SubCategoryName</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">Chưa có thông tin</span>
                    }
                </small>
            </div>

            <!-- Stock Info -->
            <div class="mb-4">
                <small><strong>Kho:</strong> <span class="text-success fw-bold">@Model.TotalStock</span></small>
            </div>

            <!-- Price Range -->
            <div class="mb-4">
                <h2 class="text-danger fw-bold">
                    @{
                        var minPrice = Model.Variants.Min(v => v.Price);
                        var maxPrice = Model.Variants.Max(v => v.Price);
                        if (minPrice == maxPrice)
                        {
                            @minPrice.ToString("N0") <text>₫</text>
                        }
                        else
                        {
                            @minPrice.ToString("N0") <text>₫ - </text> @maxPrice.ToString("N0") <text>₫</text>
                        }
                    }
                </h2>
            </div>

            <!-- Variants as Product Options -->
            @if (Model.Variants != null && Model.Variants.Any())
            {
                <div class="card mb-4 border">
                    <div class="card-header bg-white border-bottom">
                        <h6 class="mb-0 fw-bold text-uppercase">Sản Phẩm</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-2">
                            @foreach (var variant in Model.Variants)
                            {
                                <div class="col-12">
                                    <div class="variant-option p-3 border rounded @(variant.Stock > 0 ? "" : "disabled")"
                                         style="cursor: pointer; transition: all 0.2s;"
                                         onclick="selectVariant(@variant.Id, '@variant.Name', @variant.Price, @(variant.Stock ?? 0))">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="flex-grow-1">
                                                <div class="fw-bold text-success mb-1">@variant.Name</div>
                                                @if (variant.Stock > 0)
                                                {
                                                    <small class="text-muted">Kho: <strong class="text-success">@variant.Stock</strong></small>
                                                }
                                                else
                                                {
                                                    <small class="text-danger"><strong>Hết hàng</strong></small>
                                                }
                                            </div>
                                            <div class="text-end">
                                                <div class="text-danger fw-bold fs-5">@variant.Price.ToString("N0") ₫</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Selected Variant Info -->
                <div id="selectedVariantInfo" class="alert alert-info mb-3" style="display: none;">
                    <strong>Đã chọn:</strong> <span id="selectedVariantName"></span> -
                    <strong class="text-danger"><span id="selectedVariantPrice"></span> ₫</strong>
                    <div class="mt-2">
                        <small class="text-muted">Tồn kho: <span id="selectedVariantStock" class="fw-bold"></span></small>
                    </div>
                </div>

                <!-- Quantity Selector -->
                <div id="quantitySelector" class="card mb-3" style="display: none;">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <label for="quantityInput" class="form-label mb-0 fw-bold">Số lượng:</label>
                            </div>
                            <div class="col-auto">
                                <div class="input-group" style="width: 150px;">
                                    <button class="btn btn-outline-secondary" type="button" onclick="decreaseQuantity()" id="decreaseBtn">
                                        <i class="fas fa-minus"></i>
                                    </button>
                                    <input type="number" class="form-control text-center" id="quantityInput" 
                                           value="1" min="1" max="1" onchange="updateQuantity()" oninput="validateQuantity()">
                                    <button class="btn btn-outline-secondary" type="button" onclick="increaseQuantity()" id="increaseBtn">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col">
                                <div class="text-end">
                                    <small class="text-muted">Tổng tiền:</small>
                                    <div class="fs-4 fw-bold text-danger" id="totalPrice">0 ₫</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Buy Button -->
                <div class="d-grid gap-2 mb-4">
                    <button id="buyButton" class="btn btn-success btn-lg" disabled onclick="buyProduct()">
                        <i class="fas fa-shopping-cart me-2"></i>
                        <strong>Mua ngay</strong>
                    </button>
                </div>
            }

            <!-- Description -->
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="alert alert-success">
                    <small>
                        <i class="fas fa-check-circle me-2"></i>
                        <em>@Model.Description</em>
                    </small>
                </div>
            }
        </div>
    </div>

    <!-- Product Details Section -->
    @if (!string.IsNullOrEmpty(Model.Details))
    {
        <div class="row mt-5">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0 fw-bold"><i class="fas fa-info-circle me-2"></i>Chi tiết sản phẩm</h5>
                    </div>
                    <div class="card-body">
                        @Html.Raw(Model.Details)
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Back Button -->
    <div class="text-center mt-5 mb-5">
        <a href="/Product/Index" class="btn btn-outline-primary btn-lg px-5">
            <i class="fas fa-arrow-left me-2"></i>Quay lại danh sách
        </a>
    </div>
</div>

<!-- Success Modal -->
<div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-body text-center p-5">
                <div class="mb-4">
                    <div class="success-icon mx-auto mb-3">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <h4 class="modal-title text-success fw-bold" id="successModalLabel">Mua hàng thành công!</h4>
                </div>
                <p class="text-muted mb-3" id="successMessage"></p>
                <div class="alert alert-light border mb-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Tổng tiền:</span>
                        <strong class="text-danger fs-5" id="successTotalAmount"></strong>
                    </div>
                </div>
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-success btn-lg" id="viewOrderBtn">
                        <i class="fas fa-shopping-bag me-2"></i>Xem đơn hàng
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>Đóng
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Error Modal -->
<div class="modal fade" id="errorModal" tabindex="-1" aria-labelledby="errorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-body text-center p-5">
                <div class="mb-4">
                    <div class="error-icon mx-auto mb-3">
                        <i class="fas fa-exclamation-circle"></i>
                    </div>
                    <h4 class="modal-title text-danger fw-bold" id="errorModalLabel">Có lỗi xảy ra</h4>
                </div>
                <p class="text-muted mb-4" id="errorMessage"></p>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Đóng
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .variant-option {
        background: #f8f9fa;
        transition: all 0.3s ease;
    }

        .variant-option:hover:not(.disabled) {
            background: #e7f5ff;
            border-color: #28a745 !important;
            box-shadow: 0 2px 8px rgba(40, 167, 69, 0.2);
            transform: translateX(5px);
        }

        .variant-option.disabled {
            opacity: 0.5;
            cursor: not-allowed !important;
        }

        .variant-option.selected {
            background: #d4edda;
            border-color: #28a745 !important;
            border-width: 2px !important;
        }

    #quantitySelector {
        border: 1px solid #dee2e6;
        border-radius: 8px;
    }

    #quantityInput {
        border-left: none;
        border-right: none;
        font-weight: 600;
    }

    #quantityInput:focus {
        border-color: #ced4da;
        box-shadow: none;
    }

    #decreaseBtn, #increaseBtn {
        border-color: #ced4da;
        transition: all 0.2s;
    }

    #decreaseBtn:hover, #increaseBtn:hover {
        background-color: #e9ecef;
        border-color: #adb5bd;
    }

    #totalPrice {
        color: #dc3545;
        letter-spacing: 0.5px;
    }

    /* Success Modal Styles */
    .success-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2.5rem;
        box-shadow: 0 4px 15px rgba(40, 167, 69, 0.3);
        animation: scaleIn 0.3s ease-out;
    }

    .error-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2.5rem;
        box-shadow: 0 4px 15px rgba(220, 53, 69, 0.3);
        animation: scaleIn 0.3s ease-out;
    }

    @@keyframes scaleIn {
        from {
            transform: scale(0);
            opacity: 0;
        }
        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .modal-content {
        border-radius: 15px;
        overflow: hidden;
    }

    .modal-body {
        padding: 2rem;
    }

    #successModal .modal-body {
        background: linear-gradient(to bottom, #f8f9fa 0%, #ffffff 100%);
    }

    #errorModal .modal-body {
        background: linear-gradient(to bottom, #fff5f5 0%, #ffffff 100%);
    }
</style>

<script>
    let selectedVariantId = null;
    let selectedVariantPrice = 0;
    let selectedVariantStock = 0;
    let currentQuantity = 1;

    function selectVariant(variantId, variantName, price, stock) {
        if (stock <= 0) return;

        selectedVariantId = variantId;
        selectedVariantPrice = price;
        selectedVariantStock = stock;

        // Remove previous selection
        document.querySelectorAll('.variant-option').forEach(el => {
            el.classList.remove('selected');
        });

        // Add selected class
        event.currentTarget.classList.add('selected');

        // Update selected info
        document.getElementById('selectedVariantName').textContent = variantName;
        document.getElementById('selectedVariantPrice').textContent = price.toLocaleString('vi-VN');
        document.getElementById('selectedVariantStock').textContent = stock;
        document.getElementById('selectedVariantInfo').style.display = 'block';

        // Show quantity selector and reset quantity
        const quantitySelector = document.getElementById('quantitySelector');
        const quantityInput = document.getElementById('quantityInput');
        quantityInput.max = stock;
        quantityInput.value = 1;
        currentQuantity = 1;
        quantitySelector.style.display = 'block';
        
        // Update total price and button states
        updateTotalPrice();
        updateButtonStates();
        
        // Enable buy button
        document.getElementById('buyButton').disabled = false;
    }

    function updateButtonStates() {
        const decreaseBtn = document.getElementById('decreaseBtn');
        const increaseBtn = document.getElementById('increaseBtn');
        
        decreaseBtn.disabled = (currentQuantity <= 1);
        increaseBtn.disabled = (currentQuantity >= selectedVariantStock);
    }

    function increaseQuantity() {
        const quantityInput = document.getElementById('quantityInput');
        let quantity = parseInt(quantityInput.value) || 1;
        if (quantity < selectedVariantStock) {
            quantity++;
            quantityInput.value = quantity;
            currentQuantity = quantity;
            updateTotalPrice();
            updateButtonStates();
        }
    }

    function decreaseQuantity() {
        const quantityInput = document.getElementById('quantityInput');
        let quantity = parseInt(quantityInput.value) || 1;
        if (quantity > 1) {
            quantity--;
            quantityInput.value = quantity;
            currentQuantity = quantity;
            updateTotalPrice();
            updateButtonStates();
        }
    }

    function updateQuantity() {
        const quantityInput = document.getElementById('quantityInput');
        let quantity = parseInt(quantityInput.value) || 1;
        
        if (quantity < 1) {
            quantity = 1;
            quantityInput.value = 1;
        } else if (quantity > selectedVariantStock) {
            quantity = selectedVariantStock;
            quantityInput.value = selectedVariantStock;
        }
        
        currentQuantity = quantity;
        updateTotalPrice();
        updateButtonStates();
    }

    function validateQuantity() {
        const quantityInput = document.getElementById('quantityInput');
        let quantity = parseInt(quantityInput.value) || 1;
        
        if (isNaN(quantity) || quantity < 1) {
            quantityInput.value = 1;
            currentQuantity = 1;
        } else if (quantity > selectedVariantStock) {
            quantityInput.value = selectedVariantStock;
            currentQuantity = selectedVariantStock;
        } else {
            currentQuantity = quantity;
        }
        
        updateTotalPrice();
        updateButtonStates();
    }

    function updateTotalPrice() {
        const totalPrice = selectedVariantPrice * currentQuantity;
        document.getElementById('totalPrice').textContent = totalPrice.toLocaleString('vi-VN') + ' ₫';
    }

    async function buyProduct() {
        if (!selectedVariantId) {
            alert('Vui lòng chọn sản phẩm');
            return;
        }

        if (currentQuantity < 1) {
            alert('Số lượng phải lớn hơn 0');
            return;
        }

        if (currentQuantity > selectedVariantStock) {
            alert('Số lượng không được vượt quá tồn kho (' + selectedVariantStock + ')');
            return;
        }

        @if (isLoggedIn)
        {
                <text>
                const confirmMessage = `Xác nhận mua ${currentQuantity} sản phẩm?\n` +
                    `Tổng tiền: ${(selectedVariantPrice * currentQuantity).toLocaleString('vi-VN')} ₫`;
                
                if (!confirm(confirmMessage)) {
                    return;
                }

                // Disable buy button and show loading
                const buyButton = document.getElementById('buyButton');
                const originalText = buyButton.innerHTML;
                buyButton.disabled = true;
                buyButton.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang xử lý...';

                try {
                    // Get anti-forgery token
                    const token = getAntiForgeryToken();
                    if (!token) {
                        alert('Lỗi bảo mật. Vui lòng tải lại trang.');
                        buyButton.disabled = false;
                        buyButton.innerHTML = originalText;
                        return;
                    }

                    // Create form data to send with anti-forgery token
                    const formData = new FormData();
                    formData.append('variantId', selectedVariantId);
                    formData.append('quantity', currentQuantity);
                    formData.append('__RequestVerificationToken', token);

                    // Call API to purchase
                    const response = await fetch('/Order/Purchase?variantId=' + selectedVariantId + '&quantity=' + currentQuantity, {
                        method: 'POST',
                        body: formData
                    });

                    // Check if response is OK
                    if (!response.ok) {
                        const errorText = await response.text();
                        
                        try {
                            const errorResult = JSON.parse(errorText);
                            const errorMsg = errorResult.Message || errorResult.message || 'Có lỗi xảy ra khi mua hàng';
                            document.getElementById('errorMessage').textContent = errorMsg;
                            const errorModal = new bootstrap.Modal(document.getElementById('errorModal'));
                            errorModal.show();
                        } catch {
                            document.getElementById('errorMessage').textContent = 'Có lỗi xảy ra khi mua hàng (Status: ' + response.status + ')';
                            const errorModal = new bootstrap.Modal(document.getElementById('errorModal'));
                            errorModal.show();
                        }
                        buyButton.disabled = false;
                        buyButton.innerHTML = originalText;
                        return;
                    }

                    let result;
                    try {
                        const responseText = await response.text();
                        result = JSON.parse(responseText);
                    } catch (parseError) {
                        document.getElementById('errorMessage').textContent = 'Không thể xử lý phản hồi từ server';
                        const errorModal = new bootstrap.Modal(document.getElementById('errorModal'));
                        errorModal.show();
                        buyButton.disabled = false;
                        buyButton.innerHTML = originalText;
                        return;
                    }

                    // Check Success field (handle both camelCase and PascalCase)
                    const isSuccess = result.Success === true || result.Success === 'true' || 
                                     result.success === true || result.success === 'true' ||
                                     (result.OrderId && result.OrderId > 0) || 
                                     (result.orderId && result.orderId > 0);

                    if (isSuccess) {
                        // Get OrderId (handle both camelCase and PascalCase)
                        const orderId = result.OrderId || result.orderId;
                        const message = result.Message || result.message || 'Mua hàng thành công!';
                        const totalAmount = result.TotalAmount || result.totalAmount || (selectedVariantPrice * currentQuantity);

                        // Show success modal
                        document.getElementById('successMessage').textContent = message;
                        document.getElementById('successTotalAmount').textContent = totalAmount.toLocaleString('vi-VN') + ' ₫';
                        
                        const viewOrderBtn = document.getElementById('viewOrderBtn');
                        if (orderId) {
                            viewOrderBtn.onclick = function() {
                                window.location.href = '/Order/Detail/' + orderId;
                            };
                            viewOrderBtn.style.display = 'block';
                        } else {
                            viewOrderBtn.onclick = function() {
                                window.location.href = '/Order/MyOrders';
                            };
                            viewOrderBtn.style.display = 'block';
                        }

                        // Show modal and auto redirect after 5 seconds
                        const successModal = new bootstrap.Modal(document.getElementById('successModal'));
                        successModal.show();
                        
                        // Auto redirect after 5 seconds
                        setTimeout(function() {
                            if (orderId) {
                                window.location.href = '/Order/Detail/' + orderId;
                            } else {
                                window.location.href = '/Order/MyOrders';
                            }
                        }, 5000);
                    } else {
                        const errorMessage = result.Message || result.message || 'Có lỗi xảy ra khi mua hàng';
                        
                        // Show error modal
                        document.getElementById('errorMessage').textContent = errorMessage;
                        const errorModal = new bootstrap.Modal(document.getElementById('errorModal'));
                        errorModal.show();
                        
                        buyButton.disabled = false;
                        buyButton.innerHTML = originalText;
                    }
                } catch (error) {
                    // Show error modal
                    document.getElementById('errorMessage').textContent = 'Có lỗi xảy ra khi mua hàng: ' + error.message + '. Vui lòng thử lại.';
                    const errorModal = new bootstrap.Modal(document.getElementById('errorModal'));
                    errorModal.show();
                    
                    buyButton.disabled = false;
                    buyButton.innerHTML = originalText;
                }
                </text>
        }
        else
        {
                <text>
                document.getElementById('errorMessage').textContent = 'Bạn cần đăng nhập để mua hàng. Chuyển đến trang đăng nhập?';
                const errorModal = new bootstrap.Modal(document.getElementById('errorModal'));
                const errorModalEl = document.getElementById('errorModal');
                const errorModalBtn = errorModalEl.querySelector('button');
                errorModalBtn.innerHTML = '<i class="fas fa-sign-in-alt me-2"></i>Đăng nhập ngay';
                errorModalBtn.className = 'btn btn-primary';
                errorModalBtn.onclick = function() {
                    window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                };
                errorModal.show();
                </text>
        }
    }

    // Get anti-forgery token for POST requests
    function getAntiForgeryToken() {
        const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
        return tokenElement ? tokenElement.value : '';
    }
</script>