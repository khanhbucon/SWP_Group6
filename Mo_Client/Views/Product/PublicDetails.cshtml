@model Mo_Client.Controllers.ProductController.PublicProductDetailData
@{
    ViewData["Title"] = Model.Name;
    var isLoggedIn = ViewBag.IsLoggedIn ?? false;
}

<div class="container mt-5 pt-4">
    <div class="row">
        <!-- Product Image -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0" style="border-radius: 12px;">
                @if (!string.IsNullOrEmpty(Model.Image))
                {
                    <img src="data:image/jpeg;base64,@Model.Image" class="card-img-top" alt="@Model.Name"
                         style="max-height: 500px; object-fit: contain; border-radius: 12px;">
                }
                else
                {
                    <div class="text-center p-5 bg-light" style="min-height: 400px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="fas fa-image fa-5x text-muted"></i>
                    </div>
                }
            </div>
        </div>

        <!-- Product Info -->
        <div class="col-md-6">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Product/Index">Sản phẩm</a></li>
                    <li class="breadcrumb-item">@Model.CategoryName</li>
                    <li class="breadcrumb-item active">@Model.Name</li>
                </ol>
            </nav>

            <!-- Product Title & Badges -->
            <div class="d-flex align-items-center mb-3">
                <span class="badge bg-success me-2 px-3 py-2">SẢN PHẨM</span>
                <h4 class="mb-0 fw-bold">@Model.Name</h4>
            </div>

            <!-- Rating & Stats (có thể thêm sau) -->
            <div class="mb-3 d-flex align-items-center">
                <div class="text-warning me-3">
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star-half-alt"></i>
                    <span class="text-muted ms-2">(0 Reviews)</span>
                </div>
                <span class="text-muted">| Đã bán: <strong>@Model.TotalSold</strong></span>
                <span class="text-muted ms-3">| Kho: <strong class="@(Model.TotalStock > 0 ? "text-success" : "text-danger")">@Model.TotalStock</strong></span>
            </div>

            <!-- Shop Info -->
            <div class="card mb-3 border-0 bg-light">
                <div class="card-body py-2">
                    <small>
                        <strong>Người bán:</strong>
                        <span class="text-primary">@Model.ShopName</span>
                        <span class="badge bg-success ms-2"><i class="fas fa-check-circle"></i> Đã xác thực</span>
                    </small>
                </div>
            </div>

            <!-- Category -->
            <div class="mb-3">
                <small><strong>Sản phẩm:</strong> <a href="#" class="text-decoration-none">@Model.SubCategoryName</a></small>
            </div>

            <!-- Stock Info -->
            <div class="mb-4">
                <small><strong>Kho:</strong> <span class="text-success fw-bold">@Model.TotalStock</span></small>
            </div>

            <!-- Price Range -->
            <div class="mb-4">
                <h2 class="text-danger fw-bold">
                    @{
                        var minPrice = Model.Variants.Min(v => v.Price);
                        var maxPrice = Model.Variants.Max(v => v.Price);
                        if (minPrice == maxPrice)
                        {
                            @minPrice.ToString("N0") <text>₫</text>
                        }
                        else
                        {
                            @minPrice.ToString("N0") <text>₫ - </text> @maxPrice.ToString("N0") <text>₫</text>
                        }
                    }
                </h2>
            </div>

            <!-- Variants as Product Options -->
            @if (Model.Variants != null && Model.Variants.Any())
            {
                <div class="card mb-4 border">
                    <div class="card-header bg-white border-bottom">
                        <h6 class="mb-0 fw-bold text-uppercase">Sản Phẩm</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-2">
                            @foreach (var variant in Model.Variants)
                            {
                                <div class="col-12">
                                    <div class="variant-option p-3 border rounded @(variant.Stock > 0 ? "" : "disabled")"
                                         style="cursor: pointer; transition: all 0.2s;"
                                         onclick="selectVariant(@variant.Id, '@variant.Name', @variant.Price, @(variant.Stock ?? 0))">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="flex-grow-1">
                                                <div class="fw-bold text-success mb-1">@variant.Name</div>
                                                @if (variant.Stock > 0)
                                                {
                                                    <small class="text-muted">Kho: <strong class="text-success">@variant.Stock</strong></small>
                                                }
                                                else
                                                {
                                                    <small class="text-danger"><strong>Hết hàng</strong></small>
                                                }
                                            </div>
                                            <div class="text-end">
                                                <div class="text-danger fw-bold fs-5">@variant.Price.ToString("N0") ₫</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Selected Variant Info & Buy Button -->
                <div id="selectedVariantInfo" class="alert alert-info mb-3" style="display: none;">
                    <strong>Đã chọn:</strong> <span id="selectedVariantName"></span> -
                    <strong class="text-danger"><span id="selectedVariantPrice"></span> ₫</strong>
                </div>

                <div class="d-grid gap-2 mb-4">
                    <button id="buyButton" class="btn btn-success btn-lg" disabled onclick="buyProduct()">
                        <i class="fas fa-shopping-cart me-2"></i>
                        <strong>Mua ngay</strong>
                    </button>
                </div>
            }

            <!-- Description -->
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="alert alert-success">
                    <small>
                        <i class="fas fa-check-circle me-2"></i>
                        <em>@Model.Description</em>
                    </small>
                </div>
            }
        </div>
    </div>

    <!-- Product Details Section -->
    @if (!string.IsNullOrEmpty(Model.Details))
    {
        <div class="row mt-5">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0 fw-bold"><i class="fas fa-info-circle me-2"></i>Chi tiết sản phẩm</h5>
                    </div>
                    <div class="card-body">
                        @Html.Raw(Model.Details)
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Back Button -->
    <div class="text-center mt-5 mb-5">
        <a href="/Product/Index" class="btn btn-outline-primary btn-lg px-5">
            <i class="fas fa-arrow-left me-2"></i>Quay lại danh sách
        </a>
    </div>
</div>

<style>
    .variant-option {
        background: #f8f9fa;
        transition: all 0.3s ease;
    }

        .variant-option:hover:not(.disabled) {
            background: #e7f5ff;
            border-color: #28a745 !important;
            box-shadow: 0 2px 8px rgba(40, 167, 69, 0.2);
            transform: translateX(5px);
        }

        .variant-option.disabled {
            opacity: 0.5;
            cursor: not-allowed !important;
        }

        .variant-option.selected {
            background: #d4edda;
            border-color: #28a745 !important;
            border-width: 2px !important;
        }
</style>

<script>
    let selectedVariantId = null;

    function selectVariant(variantId, variantName, price, stock) {
        if (stock <= 0) return;

        selectedVariantId = variantId;

        // Remove previous selection
        document.querySelectorAll('.variant-option').forEach(el => {
            el.classList.remove('selected');
        });

        // Add selected class
        event.currentTarget.classList.add('selected');

        // Update selected info
        document.getElementById('selectedVariantName').textContent = variantName;
        document.getElementById('selectedVariantPrice').textContent = price.toLocaleString('vi-VN');
        document.getElementById('selectedVariantInfo').style.display = 'block';
        document.getElementById('buyButton').disabled = false;
    }

    function buyProduct() {
        if (!selectedVariantId) {
            alert('Vui lòng chọn sản phẩm');
            return;
        }

        @if (isLoggedIn)
        {
                <text>
                // TODO: Implement purchase logic
                if (confirm('Xác nhận mua sản phẩm này?')) {
                    alert('Đang xử lý đơn hàng... Variant ID: ' + selectedVariantId);
                    // Call API to create order
                    // window.location.href = '/Order/Create?variantId=' + selectedVariantId;
                }
                </text>
        }
        else
        {
                <text>
                if (confirm('Bạn cần đăng nhập để mua hàng. Chuyển đến trang đăng nhập?')) {
                    window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                }
                </text>
        }
    }
</script>