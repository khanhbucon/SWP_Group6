</style>

<script>
    let selectedVariantId = null;
    let selectedVariantPrice = 0;
    let selectedVariantStock = 0;
    let currentQuantity = 1;

    function selectVariant(variantId, variantName, price, stock) {
        if (stock <= 0) return;

        selectedVariantId = variantId;
        selectedVariantPrice = price;
        selectedVariantStock = stock;

        // Remove previous selection
        document.querySelectorAll('.variant-option').forEach(el => {
            el.classList.remove('selected');
        });

        // Add selected class
        event.currentTarget.classList.add('selected');

        // Update selected info
        document.getElementById('selectedVariantName').textContent = variantName;
        document.getElementById('selectedVariantPrice').textContent = price.toLocaleString('vi-VN');
        document.getElementById('selectedVariantStock').textContent = stock;
        document.getElementById('selectedVariantInfo').style.display = 'block';

        // Show quantity selector and reset quantity
        const quantitySelector = document.getElementById('quantitySelector');
        const quantityInput = document.getElementById('quantityInput');
        quantityInput.max = stock;
        quantityInput.value = 1;
        currentQuantity = 1;
        quantitySelector.style.display = 'block';
        
        // Update total price and button states
        updateTotalPrice();
        updateButtonStates();
        
        // Enable buy button
        document.getElementById('buyButton').disabled = false;
    }

    function updateButtonStates() {
        const decreaseBtn = document.getElementById('decreaseBtn');
        const increaseBtn = document.getElementById('increaseBtn');
        
        decreaseBtn.disabled = (currentQuantity <= 1);
        increaseBtn.disabled = (currentQuantity >= selectedVariantStock);
    }

    function increaseQuantity() {
        const quantityInput = document.getElementById('quantityInput');
        let quantity = parseInt(quantityInput.value) || 1;
        if (quantity < selectedVariantStock) {
            quantity++;
            quantityInput.value = quantity;
            currentQuantity = quantity;
            updateTotalPrice();
            updateButtonStates();
        }
    }

    function decreaseQuantity() {
        const quantityInput = document.getElementById('quantityInput');
        let quantity = parseInt(quantityInput.value) || 1;
        if (quantity > 1) {
            quantity--;
            quantityInput.value = quantity;
            currentQuantity = quantity;
            updateTotalPrice();
            updateButtonStates();
        }
    }

    function updateQuantity() {
        const quantityInput = document.getElementById('quantityInput');
        let quantity = parseInt(quantityInput.value) || 1;
        
        if (quantity < 1) {
            quantity = 1;
            quantityInput.value = 1;
        } else if (quantity > selectedVariantStock) {
            quantity = selectedVariantStock;
            quantityInput.value = selectedVariantStock;
        }
        
        currentQuantity = quantity;
        updateTotalPrice();
        updateButtonStates();
    }

    function validateQuantity() {
        const quantityInput = document.getElementById('quantityInput');
        let quantity = parseInt(quantityInput.value) || 1;
        
        if (isNaN(quantity) || quantity < 1) {
            quantityInput.value = 1;
            currentQuantity = 1;
        } else if (quantity > selectedVariantStock) {
            quantityInput.value = selectedVariantStock;
            currentQuantity = selectedVariantStock;
        } else {
            currentQuantity = quantity;
        }
        
        updateTotalPrice();
        updateButtonStates();
    }

    function updateTotalPrice() {
        const totalPrice = selectedVariantPrice * currentQuantity;
        document.getElementById('totalPrice').textContent = totalPrice.toLocaleString('vi-VN') + ' ₫';
    }

    async function buyProduct() {
        if (!selectedVariantId) {
            alert('Vui lòng chọn sản phẩm');
            return;
        }

        if (currentQuantity < 1) {
            alert('Số lượng phải lớn hơn 0');
            return;
        }

        if (currentQuantity > selectedVariantStock) {
            alert('Số lượng không được vượt quá tồn kho (' + selectedVariantStock + ')');
            return;
        }

        @if (isLoggedIn)
        {
                <text>
                const confirmMessage = `Xác nhận mua ${currentQuantity} sản phẩm?\n` +
                    `Tổng tiền: ${(selectedVariantPrice * currentQuantity).toLocaleString('vi-VN')} ₫`;
                
                if (!confirm(confirmMessage)) {
                    return;
                }

                // Disable buy button and show loading
                const buyButton = document.getElementById('buyButton');
                const originalText = buyButton.innerHTML;
                buyButton.disabled = true;
                buyButton.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang xử lý...';

                try {
                    // Get anti-forgery token
                    const token = getAntiForgeryToken();
                    if (!token) {
                        alert('Lỗi bảo mật. Vui lòng tải lại trang.');
                        buyButton.disabled = false;
                        buyButton.innerHTML = originalText;
                        return;
                    }

                    // Create form data to send with anti-forgery token
                    const formData = new FormData();
                    formData.append('variantId', selectedVariantId);
                    formData.append('quantity', currentQuantity);
                    formData.append('__RequestVerificationToken', token);

                    // Call API to purchase
                    const response = await fetch('/Order/Purchase?variantId=' + selectedVariantId + '&quantity=' + currentQuantity, {
                        method: 'POST',
                        body: formData
                    });

                    // Check if response is OK
                    if (!response.ok) {
                        const errorText = await response.text();
                        
                        try {
                            const errorResult = JSON.parse(errorText);
                            const errorMsg = errorResult.Message || errorResult.message || 'Có lỗi xảy ra khi mua hàng';
                            document.getElementById('errorMessage').textContent = errorMsg;
                            const errorModal = new bootstrap.Modal(document.getElementById('errorModal'));
                            errorModal.show();
                        } catch {
                            document.getElementById('errorMessage').textContent = 'Có lỗi xảy ra khi mua hàng (Status: ' + response.status + ')';
                            const errorModal = new bootstrap.Modal(document.getElementById('errorModal'));
                            errorModal.show();
                        }
                        buyButton.disabled = false;
                        buyButton.innerHTML = originalText;
                        return;
                    }

                    let result;
                    try {
                        const responseText = await response.text();
                        result = JSON.parse(responseText);
                    } catch (parseError) {
                        document.getElementById('errorMessage').textContent = 'Không thể xử lý phản hồi từ server';
                        const errorModal = new bootstrap.Modal(document.getElementById('errorModal'));
                        errorModal.show();
                        buyButton.disabled = false;
                        buyButton.innerHTML = originalText;
                        return;
                    }

                    // Check Success field (handle both camelCase and PascalCase)
                    const isSuccess = result.Success === true || result.Success === 'true' || 
                                     result.success === true || result.success === 'true' ||
                                     (result.OrderId && result.OrderId > 0) || 
                                     (result.orderId && result.orderId > 0);

                    if (isSuccess) {
                        // Get OrderId (handle both camelCase and PascalCase)
                        const orderId = result.OrderId || result.orderId;
                        const message = result.Message || result.message || 'Mua hàng thành công!';
                        const totalAmount = result.TotalAmount || result.totalAmount || (selectedVariantPrice * currentQuantity);

                        // Show success modal
                        document.getElementById('successMessage').textContent = message;
                        document.getElementById('successTotalAmount').textContent = totalAmount.toLocaleString('vi-VN') + ' ₫';
                        
                        const viewOrderBtn = document.getElementById('viewOrderBtn');
                        if (orderId) {
                            viewOrderBtn.onclick = function() {
                                window.location.href = '/Order/Detail/' + orderId;
                            };
                            viewOrderBtn.style.display = 'block';
                        } else {
                            viewOrderBtn.onclick = function() {
                                window.location.href = '/Order/MyOrders';
                            };
                            viewOrderBtn.style.display = 'block';
                        }

                        // Show modal and auto redirect after 5 seconds
                        const successModal = new bootstrap.Modal(document.getElementById('successModal'));
                        successModal.show();
                        
                        // Auto redirect after 5 seconds
                        setTimeout(function() {
                            if (orderId) {
                                window.location.href = '/Order/Detail/' + orderId;
                            } else {
                                window.location.href = '/Order/MyOrders';
                            }
                        }, 5000);
                    } else {
                        const errorMessage = result.Message || result.message || 'Có lỗi xảy ra khi mua hàng';
                        
                        // Show error modal
                        document.getElementById('errorMessage').textContent = errorMessage;
                        const errorModal = new bootstrap.Modal(document.getElementById('errorModal'));
                        errorModal.show();
                        
                        buyButton.disabled = false;
                        buyButton.innerHTML = originalText;
                    }
                } catch (error) {
                    // Show error modal
                    document.getElementById('errorMessage').textContent = 'Có lỗi xảy ra khi mua hàng: ' + error.message + '. Vui lòng thử lại.';
                    const errorModal = new bootstrap.Modal(document.getElementById('errorModal'));
                    errorModal.show();
                    
                    buyButton.disabled = false;
                    buyButton.innerHTML = originalText;
                }
                </text>
        }
        else
        {
                <text>
                document.getElementById('errorMessage').textContent = 'Bạn cần đăng nhập để mua hàng. Chuyển đến trang đăng nhập?';
                const errorModal = new bootstrap.Modal(document.getElementById('errorModal'));
                const errorModalEl = document.getElementById('errorModal');
                const errorModalBtn = errorModalEl.querySelector('button');
                errorModalBtn.innerHTML = '<i class="fas fa-sign-in-alt me-2"></i>Đăng nhập ngay';
                errorModalBtn.className = 'btn btn-primary';
                errorModalBtn.onclick = function() {
                    window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                };
                errorModal.show();
                </text>
        }
    }

    // Get anti-forgery token for POST requests
    function getAntiForgeryToken() {
        const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
        return tokenElement ? tokenElement.value : '';
    }

    // Load feedbacks
    async function loadFeedbacks() {
        const productId = @Model.Id;
        const container = document.getElementById('feedbacksContainer');
        
        console.log('loadFeedbacks called, productId:', productId);
        console.log('Container element:', container);
        
        if (!container) {
            console.error('feedbacksContainer not found');
            return;
        }
        
        try {
            // Get API base URL from ViewBag or construct from current location
            const apiBaseUrl = '@(ViewBag.ApiBaseUrl ?? "")';
            let apiUrl;
            
            if (apiBaseUrl && apiBaseUrl.trim() !== '') {
                // Use ViewBag API base URL
                apiUrl = `${apiBaseUrl}/Product/${productId}/feedbacks`;
            } else {
                // Fallback: construct from current page URL
                const currentUrl = window.location.origin;
                apiUrl = `${currentUrl}/api/Product/${productId}/feedbacks`;
            }
            
            console.log('API Base URL:', apiBaseUrl);
            console.log('Loading feedbacks from:', apiUrl);
            
            const response = await fetch(apiUrl, {
                method: 'GET',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json'
                }
            });
            
            console.log('Response status:', response.status);
            console.log('Response headers:', response.headers);
            
            if (!response.ok) {
                const errorText = await response.text();
                console.error('API Error:', errorText);
                throw new Error(`HTTP error! status: ${response.status}, message: ${errorText}`);
            }
            
            const responseText = await response.text();
            console.log('Response text:', responseText);
            
            let result;
            try {
                result = JSON.parse(responseText);
            } catch (parseError) {
                console.error('JSON Parse Error:', parseError);
                console.error('Response text that failed to parse:', responseText);
                throw new Error('Failed to parse JSON response');
            }
            
            console.log('Feedbacks response:', result);
            console.log('Feedbacks Success:', result.Success);
            console.log('Feedbacks success (lowercase):', result.success);
            console.log('Feedbacks Data:', result.Data);
            console.log('Feedbacks data (lowercase):', result.data);
            console.log('Feedbacks Data type:', typeof result.Data);
            console.log('Feedbacks Data length:', result.Data?.length);
            
            // Handle both PascalCase and camelCase response formats
            const isSuccess = result.Success === true || result.success === true;
            const feedbackData = result.Data || result.data || [];
            
            console.log('Is Success:', isSuccess);
            console.log('Feedback Data (normalized):', feedbackData);
            console.log('Feedback Data length:', feedbackData.length);
            
            if (isSuccess && feedbackData && Array.isArray(feedbackData) && feedbackData.length > 0) {
                console.log('Rendering feedbacks, count:', feedbackData.length);
                container.innerHTML = feedbackData.map((feedback, index) => {
                    console.log(`Processing feedback ${index}:`, feedback);
                    
                    // Handle both camelCase and PascalCase - check all possible property names
                    const userName = feedback.userName || feedback.UserName || 'Người dùng ẩn danh';
                    const rating = feedback.rating || feedback.Rating || 0;
                    
                    // Try multiple property name variations
                    const comment = (feedback.comment || feedback.Comment || feedback.commentText || feedback.CommentText || '').trim();
                    console.log(`Feedback ${index} comment:`, comment);
                    
                    const createdAt = feedback.createdAt || feedback.CreatedAt;
                    const replies = feedback.replies || feedback.Replies || [];
                    
                    // Build comment HTML
                    let commentHtml = '';
                    if (comment && comment.length > 0) {
                        commentHtml = `<p>${escapeHtml(comment)}</p>`;
                    } else {
                        commentHtml = '<p class="text-muted"><em>Không có bình luận</em></p>';
                    }
                    
                    // Build replies HTML
                    let repliesHtml = '';
                    if (replies && replies.length > 0) {
                        repliesHtml = `
                            <div class="replies-section">
                                <div class="replies-header">
                                    <i class="fas fa-reply replies-icon"></i>
                                    <span class="replies-title">Phản hồi từ cửa hàng (${replies.length})</span>
                                </div>
                                ${replies.map(reply => {
                                    const shopName = (reply.shopName || reply.ShopName || 'Cửa hàng').trim();
                                    const replyComment = (reply.comment || reply.Comment || '').trim();
                                    const replyCreatedAt = reply.createdAt || reply.CreatedAt;
                                    
                                    let replyCommentHtml = '';
                                    if (replyComment && replyComment.length > 0) {
                                        replyCommentHtml = `<p class="reply-text">${escapeHtml(replyComment)}</p>`;
                                    } else {
                                        replyCommentHtml = '<p class="reply-text text-muted"><em>Không có nội dung</em></p>';
                                    }
                                    
                                    return `
                                    <div class="reply-card">
                                        <div class="reply-header">
                                            <div class="reply-shop-info">
                                                <i class="fas fa-store reply-shop-icon"></i>
                                                <strong class="reply-shop-name">${escapeHtml(shopName)}</strong>
                                            </div>
                                            <small class="reply-date">${formatDate(replyCreatedAt)}</small>
                                        </div>
                                        <div class="reply-content">
                                            ${replyCommentHtml}
                                        </div>
                                    </div>
                                    `;
                                }).join('')}
                            </div>
                        `;
                    }
                    
                    return `
                    <div class="feedback-item-card">
                        <div class="feedback-header">
                            <div class="feedback-user">
                                <div class="user-avatar">
                                    <i class="fas fa-user"></i>
                                </div>
                                <div class="user-info">
                                    <div class="user-name">${escapeHtml(userName)}</div>
                                    <div class="feedback-meta">
                                        <div class="feedback-stars">${renderStars(rating)}</div>
                                        <span class="feedback-date">${formatDate(createdAt)}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="feedback-content">
                            ${commentHtml}
                        </div>
                        ${repliesHtml}
                    </div>
                    `;
                }).join('');
                
                console.log('Feedbacks HTML rendered successfully');
                console.log('Container innerHTML length:', container.innerHTML.length);
            } else {
                console.log('No feedbacks to display');
                console.log('Is Success:', isSuccess);
                console.log('Feedback Data:', feedbackData);
                console.log('Is Array:', Array.isArray(feedbackData));
                
                container.innerHTML = `
                    <div class="empty-feedbacks">
                        <div class="empty-icon">
                            <i class="fas fa-comment-slash"></i>
                        </div>
                        <p class="empty-text">Chưa có đánh giá nào cho sản phẩm này</p>
                        <p class="empty-subtext">Hãy là người đầu tiên đánh giá sản phẩm này!</p>
                    </div>
                `;
            }
        } catch (error) {
            console.error('Error loading feedbacks:', error);
            console.error('Error stack:', error.stack);
            container.innerHTML = `
                <div class="error-feedbacks">
                    <div class="error-icon">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <p class="error-text">Không thể tải đánh giá</p>
                    <p class="error-subtext">Vui lòng thử lại sau</p>
                    <small class="error-details">Lỗi: ${escapeHtml(error.message)}</small>
                </div>
            `;
        }
    }

    function renderStars(rating) {
        const fullStars = Math.floor(rating);
        const hasHalfStar = rating - fullStars >= 0.5;
        let html = '';
        
        for (let i = 0; i < fullStars; i++) {
            html += '<i class="fas fa-star star-filled"></i>';
        }
        if (hasHalfStar) {
            html += '<i class="fas fa-star-half-alt star-half"></i>';
        }
        const emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);
        for (let i = 0; i < emptyStars; i++) {
            html += '<i class="far fa-star star-empty"></i>';
        }
        return html;
    }

    function formatDate(dateString) {
        if (!dateString) return '';
        const date = new Date(dateString);
        return date.toLocaleDateString('vi-VN', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
        });
    }

    function escapeHtml(text) {
        if (text == null || text === undefined) return '';
        if (typeof text !== 'string') {
            text = String(text);
        }
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // Load feedbacks when page loads
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            console.log('DOM loaded, calling loadFeedbacks');
            loadFeedbacks();
        });
    } else {
        // DOM is already ready
        console.log('DOM already ready, calling loadFeedbacks immediately');
        loadFeedbacks();
    }
</script>

