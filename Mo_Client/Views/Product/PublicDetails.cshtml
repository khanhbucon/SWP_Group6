@model Mo_Client.Controllers.ProductController.PublicProductDetailData
@{
    ViewData["Title"] = Model.Name;
    var isLoggedIn = ViewBag.IsLoggedIn ?? false;
}

@Html.AntiForgeryToken()

<div class="product-detail-wrapper">
    <div class="container mt-4 pt-4">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb breadcrumb-custom">
                <li class="breadcrumb-item"><a href="/Product/Index"><i class="fas fa-home me-1"></i>Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Product/Index">Sản phẩm</a></li>
                <li class="breadcrumb-item">@Model.CategoryName</li>
                <li class="breadcrumb-item active">@Model.Name</li>
            </ol>
        </nav>

        <div class="row g-4">
            <!-- Product Image -->
            <div class="col-lg-5 col-md-6">
                <div class="product-image-wrapper">
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <div class="product-image-container">
                            <img src="data:image/jpeg;base64,@Model.Image" class="product-image" alt="@Model.Name">
                            <div class="image-overlay"></div>
                        </div>
                    }
                    else
                    {
                        <div class="product-image-placeholder">
                            <i class="fas fa-image"></i>
                            <p class="mt-3 text-muted">Không có hình ảnh</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Product Info -->
            <div class="col-lg-7 col-md-6">
                <div class="product-info-card">
                    <!-- Product Title -->
                    <div class="product-title-section mb-4">
                        <span class="product-badge">SẢN PHẨM</span>
                        <h1 class="product-title">@Model.Name</h1>
                    </div>

                    <!-- Rating & Stats -->
                    <div class="rating-stats-section mb-4">
                        <div class="rating-display">
                            @{
                                var avgRating = Model.AverageRating;
                                var fullStars = (int)Math.Floor((double)avgRating);
                                var remainder = avgRating - fullStars;
                                var hasHalfStar = remainder >= 0.5m;
                                var emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);
                            }
                            <div class="stars-container">
                                @for (int i = 0; i < fullStars; i++)
                                {
                                    <i class="fas fa-star star-filled"></i>
                                }
                                @if (hasHalfStar)
                                {
                                    <i class="fas fa-star-half-alt star-half"></i>
                                }
                                @for (int i = 0; i < emptyStars; i++)
                                {
                                    <i class="far fa-star star-empty"></i>
                                }
                            </div>
                            <div class="rating-info">
                                <span class="rating-value">@(Model.AverageRating > 0 ? Model.AverageRating.ToString("F1") : "0.0")</span>
                                <span class="rating-separator">/</span>
                                <span class="rating-max">5.0</span>
                                <span class="rating-count">(@Model.TotalFeedbacks @(Model.TotalFeedbacks == 1 ? "đánh giá" : "đánh giá"))</span>
                            </div>
                        </div>
                        <div class="stats-row">
                            <div class="stat-item">
                                <i class="fas fa-shopping-bag stat-icon"></i>
                                <span class="stat-label">Đã bán:</span>
                                <span class="stat-value">@Model.TotalSold</span>
                            </div>
                            <div class="stat-item">
                                <i class="fas fa-box stat-icon"></i>
                                <span class="stat-label">Kho:</span>
                                <span class="stat-value @(Model.TotalStock > 0 ? "text-success" : "text-danger")">@Model.TotalStock</span>
                            </div>
                        </div>
                    </div>

                    <!-- Shop & Category Info -->
                    <div class="info-section mb-4">
                        <div class="shop-info-card">
                            <div class="shop-info-header">
                                <i class="fas fa-store shop-icon"></i>
                                <div class="shop-info-content">
                                    <span class="shop-label">Người bán</span>
                                    <span class="shop-name">@(!string.IsNullOrEmpty(Model.ShopName) ? Model.ShopName : "Chưa có thông tin")</span>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.ShopName))
                                {
                                    <span class="verified-badge"><i class="fas fa-check-circle"></i> Đã xác thực</span>
                                }
                            </div>
                        </div>
                        <div class="category-info">
                            <i class="fas fa-tag category-icon"></i>
                            <span class="category-label">Danh mục:</span>
                            @if (!string.IsNullOrEmpty(Model.SubCategoryName))
                            {
                                @if (Model.SubCategoryId.HasValue)
                                {
                                    <a href="/Product/Index?subCategoryId=@Model.SubCategoryId" class="category-link">@Model.SubCategoryName</a>
                                }
                                else
                                {
                                    <span class="category-text">@Model.SubCategoryName</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Chưa có thông tin</span>
                            }
                        </div>
                    </div>

                    <!-- Price -->
                    <div class="price-section mb-4">
                        @{
                            var minPrice = Model.Variants.Min(v => v.Price);
                            var maxPrice = Model.Variants.Max(v => v.Price);
                        }
                        @if (minPrice == maxPrice)
                        {
                            <div class="price-single">
                                <span class="price-label">Giá:</span>
                                <span class="price-value">@minPrice.ToString("N0")</span>
                                <span class="price-currency">₫</span>
                            </div>
                        }
                        else
                        {
                            <div class="price-range">
                                <span class="price-label">Giá:</span>
                                <span class="price-value">@minPrice.ToString("N0")</span>
                                <span class="price-separator">-</span>
                                <span class="price-value">@maxPrice.ToString("N0")</span>
                                <span class="price-currency">₫</span>
                            </div>
                        }
                    </div>

                    <!-- Variants as Product Options -->
                    @if (Model.Variants != null && Model.Variants.Any())
                    {
                        <div class="variants-section mb-4">
                            <h5 class="variants-title"><i class="fas fa-list me-2"></i>Chọn sản phẩm</h5>
                            <div class="variants-list">
                                @foreach (var variant in Model.Variants)
                                {
                                    <div class="variant-card @(variant.Stock > 0 ? "" : "disabled")"
                                         onclick="selectVariant(@variant.Id, '@variant.Name', @variant.Price, @(variant.Stock ?? 0))">
                                        <div class="variant-content">
                                            <div class="variant-info">
                                                <div class="variant-name">@variant.Name</div>
                                                @if (variant.Stock > 0)
                                                {
                                                    <div class="variant-stock">
                                                        <i class="fas fa-check-circle text-success me-1"></i>
                                                        <span>Còn hàng: <strong>@variant.Stock</strong></span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="variant-stock text-danger">
                                                        <i class="fas fa-times-circle me-1"></i>
                                                        <strong>Hết hàng</strong>
                                                    </div>
                                                }
                                            </div>
                                            <div class="variant-price">
                                                <span class="price-amount">@variant.Price.ToString("N0")</span>
                                                <span class="price-unit">₫</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Selected Variant Info -->
                        <div id="selectedVariantInfo" class="selected-variant-card" style="display: none;">
                            <div class="selected-variant-content">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                <div class="selected-variant-info">
                                    <div class="selected-variant-name">Đã chọn: <strong id="selectedVariantName"></strong></div>
                                    <div class="selected-variant-details">
                                        <span class="selected-price"><strong id="selectedVariantPrice"></strong> ₫</span>
                                        <span class="selected-stock">| Tồn kho: <strong id="selectedVariantStock"></strong></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Quantity Selector -->
                        <div id="quantitySelector" class="quantity-section" style="display: none;">
                            <div class="quantity-controls">
                                <label class="quantity-label">Số lượng:</label>
                                <div class="quantity-input-group">
                                    <button class="quantity-btn" type="button" onclick="decreaseQuantity()" id="decreaseBtn">
                                        <i class="fas fa-minus"></i>
                                    </button>
                                    <input type="number" class="quantity-input" id="quantityInput" 
                                           value="1" min="1" max="1" onchange="updateQuantity()" oninput="validateQuantity()">
                                    <button class="quantity-btn" type="button" onclick="increaseQuantity()" id="increaseBtn">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="total-price-display">
                                <span class="total-label">Tổng tiền:</span>
                                <span class="total-amount" id="totalPrice">0 ₫</span>
                            </div>
                        </div>

                        <!-- Buy Button -->
                        <div class="buy-button-section mb-4">
                            <button id="buyButton" class="buy-button" disabled onclick="buyProduct()">
                                <i class="fas fa-shopping-cart me-2"></i>
                                <span>Mua ngay</span>
                            </button>
                        </div>
                    }

                    <!-- Description -->
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="description-card">
                            <i class="fas fa-info-circle description-icon"></i>
                            <p class="description-text">@Model.Description</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Product Details Section -->
        @if (!string.IsNullOrEmpty(Model.Details))
        {
            <div class="row mt-5">
                <div class="col-12">
                    <div class="details-card">
                        <div class="details-header">
                            <i class="fas fa-info-circle me-2"></i>
                            <h5 class="details-title">Chi tiết sản phẩm</h5>
                        </div>
                        <div class="details-content">
                            @Html.Raw(Model.Details)
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Feedbacks Section -->
        <div class="row mt-5">
            <div class="col-12">
                <div class="feedbacks-card">
                    <div class="feedbacks-header">
                        <div class="feedbacks-header-content">
                            <i class="fas fa-comments feedbacks-icon"></i>
                            <h5 class="feedbacks-title">Đánh giá sản phẩm</h5>
                            <span class="feedbacks-badge" id="feedbackCount">@Model.TotalFeedbacks</span>
                        </div>
                    </div>
                    <div class="feedbacks-body">
                        <div id="feedbacksContainer">
                            <div class="loading-state">
                                <div class="spinner-custom">
                                    <div class="spinner"></div>
                                </div>
                                <p class="loading-text">Đang tải đánh giá...</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Back Button -->
        <div class="text-center mt-5 mb-5">
            <a href="/Product/Index" class="back-button">
                <i class="fas fa-arrow-left me-2"></i>Quay lại danh sách
            </a>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-body text-center p-5">
                <div class="mb-4">
                    <div class="success-icon mx-auto mb-3">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <h4 class="modal-title text-success fw-bold" id="successModalLabel">Mua hàng thành công!</h4>
                </div>
                <p class="text-muted mb-3" id="successMessage"></p>
                <div class="alert alert-light border mb-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Tổng tiền:</span>
                        <strong class="text-danger fs-5" id="successTotalAmount"></strong>
                    </div>
                </div>
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-success btn-lg" id="viewOrderBtn">
                        <i class="fas fa-shopping-bag me-2"></i>Xem đơn hàng
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>Đóng
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Error Modal -->
<div class="modal fade" id="errorModal" tabindex="-1" aria-labelledby="errorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-body text-center p-5">
                <div class="mb-4">
                    <div class="error-icon mx-auto mb-3">
                        <i class="fas fa-exclamation-circle"></i>
                    </div>
                    <h4 class="modal-title text-danger fw-bold" id="errorModalLabel">Có lỗi xảy ra</h4>
                </div>
                <p class="text-muted mb-4" id="errorMessage"></p>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Đóng
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* ========== Global Styles ========== */
    .product-detail-wrapper {
        background: linear-gradient(to bottom, #f8f9fa 0%, #ffffff 100%);
        min-height: 100vh;
        padding-bottom: 3rem;
    }

    /* ========== Breadcrumb ========== */
    .breadcrumb-custom {
        background: transparent;
        padding: 0;
        margin-bottom: 1.5rem;
    }

    .breadcrumb-custom .breadcrumb-item a {
        color: #6c757d;
        text-decoration: none;
        transition: color 0.3s;
    }

    .breadcrumb-custom .breadcrumb-item a:hover {
        color: #28a745;
    }

    .breadcrumb-custom .breadcrumb-item.active {
        color: #212529;
        font-weight: 500;
    }

    /* ========== Product Image ========== */
    .product-image-wrapper {
        position: sticky;
        top: 100px;
    }

    .product-image-container {
        position: relative;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        background: #fff;
        padding: 1rem;
    }

    .product-image {
        width: 100%;
        height: auto;
        max-height: 600px;
        object-fit: contain;
        border-radius: 12px;
        transition: transform 0.3s;
    }

    .product-image:hover {
        transform: scale(1.02);
    }

    .product-image-placeholder {
        min-height: 500px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        border-radius: 16px;
        color: #6c757d;
    }

    .product-image-placeholder i {
        font-size: 5rem;
        margin-bottom: 1rem;
    }

    /* ========== Product Info Card ========== */
    .product-info-card {
        background: #fff;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    .product-title-section {
        border-bottom: 2px solid #f0f0f0;
        padding-bottom: 1rem;
    }

    .product-badge {
        display: inline-block;
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        margin-bottom: 0.75rem;
    }

    .product-title {
        font-size: 2rem;
        font-weight: 700;
        color: #212529;
        margin: 0;
        line-height: 1.3;
    }

    /* ========== Rating & Stats ========== */
    .rating-stats-section {
        padding: 1.5rem;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 12px;
    }

    .rating-display {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }

    .stars-container {
        display: flex;
        gap: 0.25rem;
    }

    .star-filled {
        color: #ffc107;
        font-size: 1.25rem;
    }

    .star-half {
        color: #ffc107;
        font-size: 1.25rem;
    }

    .star-empty {
        color: #dee2e6;
        font-size: 1.25rem;
    }

    .rating-info {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
    }

    .rating-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: #212529;
    }

    .rating-separator {
        color: #6c757d;
        font-size: 1.2rem;
    }

    .rating-max {
        color: #6c757d;
        font-size: 1.2rem;
    }

    .rating-count {
        color: #6c757d;
        font-size: 0.9rem;
        margin-left: 0.5rem;
    }

    .stats-row {
        display: flex;
        gap: 2rem;
        flex-wrap: wrap;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .stat-icon {
        color: #28a745;
        font-size: 1.1rem;
    }

    .stat-label {
        color: #6c757d;
        font-size: 0.9rem;
    }

    .stat-value {
        font-weight: 600;
        color: #212529;
    }

    /* ========== Shop & Category Info ========== */
    .info-section {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .shop-info-card {
        background: linear-gradient(135deg, #e3f2fd 0%, #f1f8ff 100%);
        border-radius: 12px;
        padding: 1rem;
        border-left: 4px solid #2196f3;
    }

    .shop-info-header {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .shop-icon {
        font-size: 1.5rem;
        color: #2196f3;
    }

    .shop-info-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .shop-label {
        font-size: 0.75rem;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .shop-name {
        font-weight: 600;
        color: #1976d2;
        font-size: 1rem;
    }

    .verified-badge {
        background: #4caf50;
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 500;
    }

    .category-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #6c757d;
        font-size: 0.9rem;
    }

    .category-icon {
        color: #ff9800;
    }

    .category-link {
        color: #ff9800;
        text-decoration: none;
        font-weight: 500;
        transition: color 0.3s;
    }

    .category-link:hover {
        color: #f57c00;
        text-decoration: underline;
    }

    /* ========== Price Section ========== */
    .price-section {
        padding: 1.5rem;
        background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
        border-radius: 12px;
        border-left: 4px solid #ff9800;
    }

    .price-single, .price-range {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .price-label {
        font-size: 0.9rem;
        color: #6c757d;
        font-weight: 500;
    }

    .price-value {
        font-size: 2rem;
        font-weight: 700;
        color: #e65100;
    }

    .price-separator {
        color: #6c757d;
        font-size: 1.5rem;
    }

    .price-currency {
        font-size: 1.5rem;
        font-weight: 600;
        color: #e65100;
    }

    /* ========== Variants ========== */
    .variants-section {
        margin-top: 1.5rem;
    }

    .variants-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #212529;
        margin-bottom: 1rem;
    }

    .variants-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .variant-card {
        background: #fff;
        border: 2px solid #e9ecef;
        border-radius: 12px;
        padding: 1.25rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .variant-card:hover:not(.disabled) {
        border-color: #28a745;
        background: #f8fff9;
        transform: translateX(5px);
        box-shadow: 0 4px 12px rgba(40, 167, 69, 0.15);
    }

    .variant-card.disabled {
        opacity: 0.6;
        cursor: not-allowed;
        background: #f5f5f5;
    }

    .variant-card.selected {
        border-color: #28a745;
        background: linear-gradient(135deg, #e8f5e9 0%, #f1f8e9 100%);
        box-shadow: 0 4px 12px rgba(40, 167, 69, 0.2);
    }

    .variant-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }

    .variant-info {
        flex: 1;
    }

    .variant-name {
        font-size: 1.1rem;
        font-weight: 600;
        color: #28a745;
        margin-bottom: 0.5rem;
    }

    .variant-stock {
        font-size: 0.85rem;
        color: #6c757d;
    }

    .variant-price {
        text-align: right;
    }

    .price-amount {
        font-size: 1.5rem;
        font-weight: 700;
        color: #e65100;
    }

    .price-unit {
        font-size: 1rem;
        color: #e65100;
        margin-left: 0.25rem;
    }

    /* ========== Selected Variant ========== */
    .selected-variant-card {
        background: linear-gradient(135deg, #e8f5e9 0%, #f1f8e9 100%);
        border: 2px solid #28a745;
        border-radius: 12px;
        padding: 1rem;
        margin-top: 1rem;
    }

    .selected-variant-content {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .selected-variant-info {
        flex: 1;
    }

    .selected-variant-name {
        font-weight: 600;
        color: #212529;
        margin-bottom: 0.25rem;
    }

    .selected-variant-details {
        font-size: 0.9rem;
        color: #6c757d;
    }

    .selected-price {
        color: #e65100;
        font-weight: 600;
    }

    /* ========== Quantity Section ========== */
    .quantity-section {
        background: #fff;
        border: 2px solid #e9ecef;
        border-radius: 12px;
        padding: 1.5rem;
        margin-top: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 2rem;
        flex-wrap: wrap;
    }

    .quantity-controls {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .quantity-label {
        font-weight: 600;
        color: #212529;
        margin: 0;
    }

    .quantity-input-group {
        display: flex;
        border: 2px solid #e9ecef;
        border-radius: 8px;
        overflow: hidden;
    }

