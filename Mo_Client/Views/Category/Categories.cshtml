@model Mo_Client.Models.Admin.CategoryManagementVm

@{
    ViewData["Title"] = "Quản lý danh mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .search-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.1);
    }
    
    .search-card .card-body {
        padding: 2rem;
    }
    
    .search-title {
        color: white;
        font-weight: 600;
        margin-bottom: 1rem;
    }
    
    .search-form {
        background: rgba(255,255,255,0.1);
        border-radius: 10px;
        padding: 1.5rem;
        backdrop-filter: blur(10px);
    }
    
    .form-control {
        border: none;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        background: rgba(255,255,255,0.9);
        transition: all 0.3s ease;
    }
    
    .form-control:focus {
        background: white;
        box-shadow: 0 0 0 0.2rem rgba(255,255,255,0.25);
    }
    
    .btn-search {
        background: linear-gradient(45deg, #ff6b6b, #ee5a24);
        border: none;
        border-radius: 8px;
        padding: 0.75rem 2rem;
        color: white;
        font-weight: 600;
        transition: all 0.3s ease;
    }
    
    .btn-search:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(255,107,107,0.4);
    }
    
    .table {
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }
    
    .table thead th {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        font-weight: 600;
        padding: 1rem;
    }
    
    .table tbody td {
        padding: 1rem;
        vertical-align: middle;
        border-color: #e9ecef;
    }
    
    .table tbody tr:hover {
        background-color: #f8f9fa;
    }
    
    .btn-group .btn {
        margin: 0 2px;
        border-radius: 6px;
        transition: all 0.3s ease;
    }
    
    .btn-group .btn:hover {
        transform: translateY(-1px);
    }
    
    .delete-btn {
        background: linear-gradient(45deg, #ff6b6b, #ee5a24);
        border: none;
        color: white;
    }
    
    .delete-btn:hover {
        background: linear-gradient(45deg, #ee5a24, #ff6b6b);
        color: white;
    }
    
    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        color: #6c757d;
    }
    
    .empty-state i {
        font-size: 3rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }
    
    .badge {
        font-size: 0.8rem;
        padding: 0.4rem 0.8rem;
        border-radius: 20px;
    }
    
    .search-badge {
        background: linear-gradient(45deg, #28a745, #20c997);
        color: white;
        font-weight: 500;
    }
    
    .subcategory-list {
        max-height: 120px;
        overflow-y: auto;
        padding: 0.5rem;
        background-color: #f8f9fa;
        border-radius: 0.375rem;
        border: 1px solid #dee2e6;
    }
    
    .subcategory-item {
        display: inline-block;
        margin: 0.25rem;
    }
    
    .subcategory-item .badge {
        font-size: 0.75rem;
        padding: 0.25rem 0.5rem;
        background-color: #007bff !important;
        color: white !important;
        border: 1px solid #0056b3;
    }
    
    .subcategory-item .badge:hover {
        background-color: #0056b3 !important;
    }
    
    .subcategory-badge {
        background-color: #28a745 !important;
        color: white !important;
        border: 1px solid #1e7e34;
        font-weight: 500;
    }
    
    .subcategory-badge:hover {
        background-color: #1e7e34 !important;
        color: white !important;
    }
    
    .subcategory-badge.inactive {
        background-color: #dc3545 !important;
        border-color: #c82333;
    }
    
    .subcategory-badge.inactive:hover {
        background-color: #c82333 !important;
    }
    
    /* Modal styling */
    .modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1050;
        background-color: rgba(0,0,0,0.5);
    }
    
    .modal.show {
        display: block !important;
    }
    
    .modal-dialog {
        position: relative;
        width: auto;
        max-width: 500px;
        margin: 1.75rem auto;
        transform: translate(0, 0);
    }
    
    .modal-content {
        position: relative;
        display: flex;
        flex-direction: column;
        width: 100%;
        background-color: #fff;
        border: 1px solid rgba(0,0,0,.2);
        border-radius: 0.3rem;
        box-shadow: 0 0.25rem 0.5rem rgba(0,0,0,.5);
    }
    
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 1040;
        width: 100vw;
        height: 100vh;
        background-color: #000;
        opacity: 0.5;
    }
</style>

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 mb-0">
                <i class="fas fa-tags"></i> Quản lý danh mục
            </h1>
            <button class="btn btn-success" onclick="showAddCategoryModal()">
                <i class="fas fa-plus"></i> Thêm danh mục
            </button>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle"></i> @TempData["Success"]
                <button type="button" class="close" data-dismiss="alert">
                    <span>&times;</span>
                </button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
                <button type="button" class="close" data-dismiss="alert">
                    <span>&times;</span>
                </button>
            </div>
        }

        <!-- Search Form -->
        <div class="card search-card mb-4">
            <div class="card-body">
                <h5 class="search-title">
                    <i class="fas fa-search"></i> Tìm kiếm danh mục
                </h5>
                <div class="search-form">
                    <form method="get" asp-action="Categories">
                        <div class="row">
                            <div class="col-md-8">
                                <div class="form-group">
                                    <label for="search" class="text-white font-weight-bold">Tìm kiếm theo tên hoặc ID:</label>
                                    <input type="text" 
                                           id="search" 
                                           name="search" 
                                           class="form-control" 
                                           placeholder="Nhập tên danh mục hoặc ID để tìm kiếm..."
                                           value="@Model.SearchTerm">
                                </div>
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <div class="form-group w-100">
                                    <button type="submit" class="btn btn-search w-100">
                                        <i class="fas fa-search"></i> Tìm kiếm
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                    
                    @if (!string.IsNullOrEmpty(Model.SearchTerm))
                    {
                        <div class="mt-3">
                            <span class="badge search-badge">
                                <i class="fas fa-filter"></i> 
                                Đang tìm kiếm: "@Model.SearchTerm"
                            </span>
                            <a href="@Url.Action("Categories")" class="btn btn-sm btn-outline-light ml-2">
                                <i class="fas fa-times"></i> Xóa bộ lọc
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Categories Table -->
        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tên danh mục</th>
                        <th>Danh mục con</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Categories.Any())
                    {
                        @foreach (var category in Model.Categories)
                        {
                            <tr>
                                <td>@category.Id</td>
                                <td>
                                    <strong>@category.Name</strong>
                                </td>
                                <td>
                                    @if (category.SubCategories.Any())
                                    {
                                        <div class="subcategory-list">
                                            @foreach (var sub in category.SubCategories)
                                            {
                                                <div class="subcategory-item">
                                                    <span class="badge subcategory-badge @(sub.IsActive == false ? "inactive" : "")">
                                                        @sub.Name
                                                        @if (sub.IsActive == false)
                                                        {
                                                            <i class="fas fa-ban ml-1" title="Tạm dừng"></i>
                                                        }
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <small class="text-muted">
                                            <i class="fas fa-info-circle"></i> 
                                            Chưa có danh mục con
                                        </small>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <a href="@Url.Action("EditCategory", new { id = category.Id })" class="btn btn-sm btn-warning" title="Sửa danh mục">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button class="btn btn-sm btn-danger delete-btn" data-id="@category.Id" data-name="@category.Name" title="Xóa danh mục">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                @if (string.IsNullOrEmpty(Model.SearchTerm))
                                {
                                    <div class="empty-state">
                                        <i class="fas fa-inbox fa-2x mb-2"></i>
                                        <div>Chưa có danh mục nào</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="empty-state">
                                        <i class="fas fa-search fa-2x mb-2"></i>
                                        <div>Không tìm thấy danh mục nào</div>
                                        <small class="text-muted">Thử từ khóa khác hoặc <a href="@Url.Action("Categories")">xem tất cả</a></small>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Hidden Form for Delete -->
<form id="deleteForm" method="post" style="display: none;">
    @Html.AntiForgeryToken()
</form>

<!-- Add Category Modal -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" style="display: none;">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm danh mục mới</h5>
                <button type="button" class="close" onclick="hideAddCategoryModal()">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="addCategoryForm" method="post" action="@Url.Action("CreateCategory", "Admin")">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label for="categoryName">Tên danh mục:</label>
                        <input type="text" id="categoryName" name="Name" class="form-control" required />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="hideAddCategoryModal()">Hủy</button>
                <button type="submit" form="addCategoryForm" class="btn btn-success">Thêm</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Sử dụng event delegation để tránh lỗi
        document.addEventListener('click', function(e) {
            if (e.target.closest('.delete-btn')) {
                e.preventDefault();
                var button = e.target.closest('.delete-btn');
                var id = button.getAttribute('data-id');
                var name = button.getAttribute('data-name');
                
                if (confirm('Bạn có chắc chắn muốn xóa danh mục "' + name + '"?')) {
                    var form = document.getElementById('deleteForm');
                    if (form) {
                        form.action = '@Url.Action("DeleteCategory", "Admin")/' + id;
                        form.submit();
                    }
                }
            }
        });
    });

    function showAddCategoryModal() {
        console.log('Opening modal...');
        const modal = document.getElementById('addCategoryModal');
        if (modal) {
            modal.style.display = 'block';
            modal.classList.add('show');
            modal.setAttribute('aria-hidden', 'false');
            document.body.classList.add('modal-open');
            
            // Tạo backdrop
            const backdrop = document.createElement('div');
            backdrop.className = 'modal-backdrop fade show';
            backdrop.id = 'modalBackdrop';
            document.body.appendChild(backdrop);
            
            console.log('Modal opened');
        } else {
            console.error('Modal not found');
        }
    }

    function hideAddCategoryModal() {
        console.log('Closing modal...');
        const modal = document.getElementById('addCategoryModal');
        if (modal) {
            modal.style.display = 'none';
            modal.classList.remove('show');
            modal.setAttribute('aria-hidden', 'true');
            document.body.classList.remove('modal-open');
            
            // Xóa backdrop
            const backdrop = document.getElementById('modalBackdrop');
            if (backdrop) {
                backdrop.remove();
            }
            
            console.log('Modal closed');
        }
    }
</script>
