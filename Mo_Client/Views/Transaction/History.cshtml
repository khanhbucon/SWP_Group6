@model Mo_Entities.ModelResponse.TransactionHistoryListResponse
@{
    ViewData["Title"] = "Lịch sử giao dịch";
}

@section Styles {
    <link rel="stylesheet" href="~/css/transaction.css" />
    <link rel="stylesheet" href="~/css/transaction-history.css" />
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-history"></i>
                        Lịch sử giao dịch
                    </h3>
                </div>
                <div class="card-body">
                    <!-- Summary Cards -->
                    <div class="row mb-4">
                        <div class="col-md-3">
                            <div class="card bg-success text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h4 class="mb-0">@Model.TotalIncome.ToString("N0") VNĐ</h4>
                                            <p class="mb-0">Tổng thu</p>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="fas fa-arrow-up fa-2x"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-danger text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h4 class="mb-0">@Model.TotalExpense.ToString("N0") VNĐ</h4>
                                            <p class="mb-0">Tổng chi</p>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="fas fa-arrow-down fa-2x"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-info text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h4 class="mb-0">@Model.NetAmount.ToString("N0") VNĐ</h4>
                                            <p class="mb-0">Số dư</p>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="fas fa-wallet fa-2x"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-primary text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h4 class="mb-0">@Model.TotalCount</h4>
                                            <p class="mb-0">Tổng giao dịch</p>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="fas fa-list fa-2x"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Search and Filter Section -->
                    <div class="card mb-4 search-section">
                        <div class="card-header">
                            <h5 class="card-title mb-0">
                                <i class="fas fa-search"></i> Tìm kiếm và lọc giao dịch
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <!-- Search Input -->
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label class="font-weight-bold">Tìm kiếm:</label>
                                        <div class="input-group">
                                            <input type="text" class="form-control" id="searchInput" placeholder="Tìm theo ID, mô tả...">
                                            <div class="input-group-append">
                                                <span class="input-group-text">
                                                    <i class="fas fa-search"></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Transaction Type Filter -->
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label class="font-weight-bold">Loại giao dịch:</label>
                                        <select class="form-control" id="typeFilter">
                                            <option value="">Tất cả</option>
                                            <option value="NapTien">Nạp tiền</option>
                                            <option value="MuaHang">Mua hàng</option>
                                            <option value="RutTien">Rút tiền</option>
                                            <option value="BanHang">Bán hàng</option>
                                            <option value="HoaHong">Hoa hồng</option>
                                            <option value="ChiaSe">Chia sẻ</option>
                                        </select>
                                    </div>
                                </div>
                                
                                <!-- Status Filter -->
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label class="font-weight-bold">Trạng thái:</label>
                                        <select class="form-control" id="statusFilter">
                                            <option value="">Tất cả</option>
                                            <option value="COMPLETED">Hoàn thành</option>
                                            <option value="PENDING">Đang xử lý</option>
                                            <option value="FAILED">Thất bại</option>
                                            <option value="CANCELLED">Đã hủy</option>
                                        </select>
                                    </div>
                                </div>
                                
                                <!-- Date Range Filter -->
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label class="font-weight-bold">Từ ngày:</label>
                                        <input type="date" class="form-control" id="dateFrom">
                                    </div>
                                </div>
                                
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label class="font-weight-bold">Đến ngày:</label>
                                        <input type="date" class="form-control" id="dateTo">
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Action Buttons -->
                            <div class="row">
                                <div class="col-12">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <button type="button" class="btn btn-primary" id="searchBtn">
                                                <i class="fas fa-search"></i> Tìm kiếm
                                            </button>
                                            <button type="button" class="btn btn-secondary ml-2" id="clearBtn">
                                                <i class="fas fa-times"></i> Xóa bộ lọc
                                            </button>
                                        </div>
                                        <div>
                                            <span class="text-muted" id="resultCount">
                                                Hiển thị <span id="visibleCount">0</span> / <span id="totalCount">0</span> giao dịch
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Transaction Table -->
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="transactionTable">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Loại giao dịch</th>
                                    <th>Số tiền</th>
                                    <th>Mô tả</th>
                                    <th>Trạng thái</th>
                                    <th>Ngày tạo</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Transactions != null && Model.Transactions.Any())
                                {
                                    @foreach (var transaction in Model.Transactions)
                                    {
                                        <tr>
                                            <td>#@transaction.Id</td>
                                            <td>
                                                <span class="badge bg-@GetTypeClass(transaction.Type)">
                                                    <i class="@GetTypeIcon(transaction.Type)"></i>
                                                    @transaction.TypeDisplay
                                                </span>
                                            </td>
                                            <td>
                                                <span class="@(transaction.IsIncome ? "text-success" : "text-danger")">
                                                    @(transaction.IsIncome ? "+" : "-")@transaction.AmountDisplay
                                                </span>
                                            </td>
                                            <td>@transaction.Description</td>
                                            <td>
                                                <span class="badge bg-@GetStatusClass(transaction.Status)">
                                                    @transaction.StatusDisplay
                                                </span>
                                            </td>
                                            <td>@transaction.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted">
                                            <i class="fas fa-inbox fa-3x mb-3"></i>
                                            <p>Chưa có giao dịch nào</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination Section -->
                    <div class="card mt-4 pagination-section">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center">
                                        <span class="text-muted mr-3">Hiển thị:</span>
                                        <select class="form-control form-control-sm" id="itemsPerPage" style="width: auto;">
                                            <option value="5">5 giao dịch/trang</option>
                                            <option value="10" selected>10 giao dịch/trang</option>
                                            <option value="20">20 giao dịch/trang</option>
                                            <option value="50">50 giao dịch/trang</option>
                                            <option value="100">100 giao dịch/trang</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="d-flex justify-content-end align-items-center">
                                        <span class="text-muted mr-3" id="paginationInfo">
                                            Trang <span id="currentPage">1</span> / <span id="totalPages">1</span>
                                        </span>
                                        <nav aria-label="Pagination">
                                            <ul class="pagination pagination-sm mb-0" id="pagination">
                                                <!-- Pagination buttons will be generated by JavaScript -->
                                            </ul>
                                        </nav>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize search functionality
            initializeSearch();
            
            // Initialize pagination
            initializePagination();
            
            // Simple table styling
            $('#transactionTable').addClass('table-hover');
            
            // Update total count on page load
            updateResultCount();
        });

        function initializeSearch() {
            // Get all table rows (excluding header)
            const $table = $('#transactionTable');
            const $rows = $table.find('tbody tr');
            const totalRows = $rows.length;
            
            // Update total count
            $('#totalCount').text(totalRows);
            
            // Search input event
            $('#searchInput').on('input', function() {
                performSearch();
            });
            
            // Filter change events
            $('#typeFilter, #statusFilter, #dateFrom, #dateTo').on('change', function() {
                performSearch();
            });
            
            // Search button click
            $('#searchBtn').on('click', function() {
                performSearch();
            });
            
            // Clear button click
            $('#clearBtn').on('click', function() {
                clearFilters();
            });
        }

        function performSearch() {
            const searchTerm = $('#searchInput').val().toLowerCase();
            const typeFilter = $('#typeFilter').val();
            const statusFilter = $('#statusFilter').val();
            const dateFrom = $('#dateFrom').val();
            const dateTo = $('#dateTo').val();
            
            const $table = $('#transactionTable');
            const $rows = $table.find('tbody tr');
            let visibleCount = 0;
            
            $rows.each(function() {
                const $row = $(this);
                const $cells = $row.find('td');
                
                // Skip empty rows
                if ($cells.length === 0) {
                    $row.hide();
                    return;
                }
                
                let showRow = true;
                
                // Search by ID and description
                if (searchTerm) {
                    const idText = $cells.eq(0).text().toLowerCase();
                    const descText = $cells.eq(3).text().toLowerCase();
                    
                    if (!idText.includes(searchTerm) && !descText.includes(searchTerm)) {
                        showRow = false;
                    }
                }
                
                // Filter by transaction type
                if (typeFilter && showRow) {
                    const typeBadge = $cells.eq(1).find('.badge');
                    const typeValue = typeBadge.attr('class');
                    
                    if (!typeValue.includes(getTypeClass(typeFilter))) {
                        showRow = false;
                    }
                }
                
                // Filter by status
                if (statusFilter && showRow) {
                    const statusBadge = $cells.eq(4).find('.badge');
                    const statusValue = statusBadge.attr('class');
                    
                    if (!statusValue.includes(getStatusClass(statusFilter))) {
                        showRow = false;
                    }
                }
                
                // Filter by date range
                if ((dateFrom || dateTo) && showRow) {
                    const dateText = $cells.eq(5).text();
                    const transactionDate = parseDate(dateText);
                    
                    if (dateFrom && transactionDate < parseDate(dateFrom)) {
                        showRow = false;
                    }
                    
                    if (dateTo && transactionDate > parseDate(dateTo)) {
                        showRow = false;
                    }
                }
                
                // Show/hide row
                if (showRow) {
                    $row.show();
                    visibleCount++;
                } else {
                    $row.hide();
                }
            });
            
            // Update visible count
            $('#visibleCount').text(visibleCount);
            
            // Show no results message if needed
            if (visibleCount === 0) {
                showNoResultsMessage();
            } else {
                hideNoResultsMessage();
            }
        }

        function clearFilters() {
            $('#searchInput').val('');
            $('#typeFilter').val('');
            $('#statusFilter').val('');
            $('#dateFrom').val('');
            $('#dateTo').val('');
            
            // Show all rows
            $('#transactionTable tbody tr').show();
            updateResultCount();
            hideNoResultsMessage();
        }

        function updateResultCount() {
            const totalRows = $('#transactionTable tbody tr:visible').length;
            const allRows = $('#transactionTable tbody tr').length;
            $('#visibleCount').text(totalRows);
            $('#totalCount').text(allRows);
        }

        function showNoResultsMessage() {
            if ($('#noResultsMessage').length === 0) {
                const $table = $('#transactionTable');
                const $tbody = $table.find('tbody');
                $tbody.append(`
                    <tr id="noResultsMessage">
                        <td colspan="6" class="text-center text-muted">
                            <i class="fas fa-search fa-3x mb-3"></i>
                            <p>Không tìm thấy giao dịch nào phù hợp với bộ lọc</p>
                        </td>
                    </tr>
                `);
            }
        }

        function hideNoResultsMessage() {
            $('#noResultsMessage').remove();
        }

        function parseDate(dateString) {
            // Parse date from format "dd/MM/yyyy HH:mm"
            const parts = dateString.split(' ');
            const datePart = parts[0];
            const [day, month, year] = datePart.split('/');
            return new Date(year, month - 1, day);
        }

        function getTypeClass(type) {
            const typeMap = {
                'NapTien': 'success',
                'MuaHang': 'primary',
                'RutTien': 'warning',
                'BanHang': 'info',
                'HoaHong': 'success',
                'ChiaSe': 'secondary'
            };
            return typeMap[type] || 'secondary';
        }

        function getStatusClass(status) {
            const statusMap = {
                'COMPLETED': 'success',
                'PENDING': 'warning',
                'FAILED': 'danger',
                'CANCELLED': 'secondary'
            };
            return statusMap[status] || 'secondary';
        }

        // Pagination functionality
        let currentPage = 1;
        let itemsPerPage = 10;
        let totalItems = 0;
        let totalPages = 1;

        function initializePagination() {
            // Get all visible rows
            updatePaginationData();
            
            // Items per page change event
            $('#itemsPerPage').on('change', function() {
                itemsPerPage = parseInt($(this).val());
                currentPage = 1;
                updatePaginationData();
                showPage(currentPage);
            });
        }

        function updatePaginationData() {
            const $table = $('#transactionTable');
            const $rows = $table.find('tbody tr:visible');
            totalItems = $rows.length;
            totalPages = Math.ceil(totalItems / itemsPerPage);
            
            // Update pagination info
            $('#currentPage').text(currentPage);
            $('#totalPages').text(totalPages);
            
            // Generate pagination buttons
            generatePaginationButtons();
        }

        function generatePaginationButtons() {
            const $pagination = $('#pagination');
            $pagination.empty();
            
            if (totalPages <= 1) {
                return;
            }
            
            // Previous button
            const prevDisabled = currentPage === 1 ? 'disabled' : '';
            $pagination.append(`
                <li class="page-item ${prevDisabled}">
                    <a class="page-link" href="#" data-page="${currentPage - 1}">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                </li>
            `);
            
            // Page numbers
            const startPage = Math.max(1, currentPage - 2);
            const endPage = Math.min(totalPages, currentPage + 2);
            
            // First page
            if (startPage > 1) {
                $pagination.append(`
                    <li class="page-item">
                        <a class="page-link" href="#" data-page="1">1</a>
                    </li>
                `);
                if (startPage > 2) {
                    $pagination.append(`
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    `);
                }
            }
            
            // Middle pages
            for (let i = startPage; i <= endPage; i++) {
                const activeClass = i === currentPage ? 'active' : '';
                $pagination.append(`
                    <li class="page-item ${activeClass}">
                        <a class="page-link" href="#" data-page="${i}">${i}</a>
                    </li>
                `);
            }
            
            // Last page
            if (endPage < totalPages) {
                if (endPage < totalPages - 1) {
                    $pagination.append(`
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    `);
                }
                $pagination.append(`
                    <li class="page-item">
                        <a class="page-link" href="#" data-page="${totalPages}">${totalPages}</a>
                    </li>
                `);
            }
            
            // Next button
            const nextDisabled = currentPage === totalPages ? 'disabled' : '';
            $pagination.append(`
                <li class="page-item ${nextDisabled}">
                    <a class="page-link" href="#" data-page="${currentPage + 1}">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                </li>
            `);
            
            // Add click events
            $pagination.find('a[data-page]').on('click', function(e) {
                e.preventDefault();
                const page = parseInt($(this).data('page'));
                if (page >= 1 && page <= totalPages && page !== currentPage) {
                    currentPage = page;
                    showPage(currentPage);
                }
            });
        }

        function showPage(page) {
            const $table = $('#transactionTable');
            const $rows = $table.find('tbody tr:visible');
            
            // Hide all rows
            $rows.hide();
            
            // Show rows for current page
            const startIndex = (page - 1) * itemsPerPage;
            const endIndex = startIndex + itemsPerPage;
            
            $rows.slice(startIndex, endIndex).show();
            
            // Update pagination info
            $('#currentPage').text(page);
            
            // Regenerate pagination buttons
            generatePaginationButtons();
            
            // Update visible count
            updateResultCount();
        }

        // Override performSearch to include pagination
        const originalPerformSearch = performSearch;
        performSearch = function() {
            originalPerformSearch();
            currentPage = 1;
            updatePaginationData();
            showPage(currentPage);
        };

        // Override clearFilters to include pagination
        const originalClearFilters = clearFilters;
        clearFilters = function() {
            originalClearFilters();
            currentPage = 1;
            updatePaginationData();
            showPage(currentPage);
        };
    </script>
}

@functions {
    string GetTypeClass(string type)
    {
        return type switch
        {
            "NapTien" => "success",
            "MuaHang" => "primary",
            "RutTien" => "warning",
            "BanHang" => "info",
            "HoaHong" => "success",
            "ChiaSe" => "secondary",
            _ => "secondary"
        };
    }

    string GetTypeIcon(string type)
    {
        return type switch
        {
            "NapTien" => "fas fa-plus-circle",
            "MuaHang" => "fas fa-shopping-cart",
            "RutTien" => "fas fa-minus-circle",
            "BanHang" => "fas fa-store",
            "HoaHong" => "fas fa-gift",
            "ChiaSe" => "fas fa-share-alt",
            _ => "fas fa-circle"
        };
    }

    string GetStatusClass(string status)
    {
        return status switch
        {
            "COMPLETED" => "success",
            "PENDING" => "warning",
            "FAILED" => "danger",
            "CANCELLED" => "secondary",
            _ => "secondary"
        };
    }
}
