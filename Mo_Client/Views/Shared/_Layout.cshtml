<!DOCTYPE html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Digital Product Selling</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Mo_Client.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Fixed Header -->
    <header class="fixed-header">
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
            <div class="container">
                <!-- Logo và Brand -->
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-digital-tachograph text-primary"></i>
                    <span class="ms-2">Digital Product Selling</span>
                </a>
                
                <!-- Mobile Toggle Button -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarNav">
                    <!-- Main Navigation Menu - Left Side -->
                    <ul class="navbar-nav main-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Product" asp-action="Index">
                                <i class="fas fa-shopping-bag"></i> Sản phẩm
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="fas fa-store"></i> Cửa hàng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="fas fa-info-circle"></i> Về chúng tôi
                            </a>
                        </li>
                    </ul>
                    
                    <!-- User Actions - Right Side -->
                    <ul class="navbar-nav user-nav">
                        @{
                            var token = Context.Request.Cookies["accessToken"];
                            var roles = Context.Request.Cookies["roles"];
                        }
                        @if (!string.IsNullOrEmpty(token))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Payment" asp-action="Deposit">
                                    <i class="fas fa-plus-circle text-success"></i> Nạp tiền
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Account" asp-action="ViewProfile">
                                    <i class="fas fa-user"></i> Tài khoản
                                </a>
                            </li>
                            @if (!string.IsNullOrEmpty(roles) && roles.Contains("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-cog"></i> Admin
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">
                                            <i class="fas fa-tachometer-alt"></i> Dashboard
                                        </a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="ManagerUser">
                                            <i class="fas fa-users"></i> Quản lý người dùng
                                        </a></li>
                                    </ul>
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(roles) && roles.Contains("Seller"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Seller" asp-action="Index">
                                        <i class="fas fa-store"></i> Seller
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <form method="post" action="/Account/Logout" class="d-inline">
                                    <button class="btn btn-outline-danger btn-sm" type="submit">
                                        <i class="fas fa-sign-out-alt"></i> Đăng xuất
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">
                                    <i class="fas fa-sign-in-alt"></i> Đăng nhập
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary ms-2" asp-area="" asp-controller="Account" asp-action="Register">
                                    <i class="fas fa-user-plus"></i> Đăng ký
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content with padding for fixed header -->
    <main class="main-content">
        @RenderBody()
    </main>

    <!-- Fixed Footer -->
    <footer class="fixed-footer">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 col-md-6 mb-4">
                    <h5 class="footer-title">
                        <i class="fas fa-digital-tachograph text-primary"></i>
                        Digital Product Selling
                    </h5>
                    <p class="footer-text">
                        Nền tảng bán sản phẩm số hàng đầu Việt Nam, 
                        kết nối người mua và người bán sản phẩm kỹ thuật số một cách an toàn, tiện lợi.
                    </p>
                    <div class="social-links">
                        <a href="#" class="social-link"><i class="fab fa-facebook"></i></a>
                        <a href="#" class="social-link"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="social-link"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="social-link"><i class="fab fa-linkedin"></i></a>
                    </div>
                </div>
                
                <div class="col-lg-2 col-md-6 mb-4">
                    <h6 class="footer-subtitle">Dành cho người mua</h6>
                    <ul class="footer-links">
                        <li><a href="#">Tìm kiếm sản phẩm</a></li>
                        <li><a href="#">Hướng dẫn mua hàng</a></li>
                        <li><a href="#">Chính sách đổi trả</a></li>
                        <li><a href="#">Bảo hành</a></li>
                    </ul>
                </div>
                
                <div class="col-lg-2 col-md-6 mb-4">
                    <h6 class="footer-subtitle">Dành cho người bán</h6>
                    <ul class="footer-links">
                        <li><a href="#">Mở cửa hàng</a></li>
                        <li><a href="#">Hướng dẫn bán hàng</a></li>
                        <li><a href="#">Quy định người bán</a></li>
                        <li><a href="#">Hỗ trợ người bán</a></li>
                    </ul>
                </div>
                
                <div class="col-lg-2 col-md-6 mb-4">
                    <h6 class="footer-subtitle">Hỗ trợ</h6>
                    <ul class="footer-links">
                        <li><a href="#">Trung tâm trợ giúp</a></li>
                        <li><a href="#">Liên hệ</a></li>
                        <li><a href="#">Báo cáo sự cố</a></li>
                        <li><a href="#">FAQ</a></li>
                    </ul>
                </div>
                
                <div class="col-lg-2 col-md-6 mb-4">
                    <h6 class="footer-subtitle">Pháp lý</h6>
                    <ul class="footer-links">
                        <li><a href="#">Điều khoản sử dụng</a></li>
                        <li><a href="#">Chính sách bảo mật</a></li>
                        <li><a href="#">Cookie Policy</a></li>
                        <li><a href="#">DMCA</a></li>
                    </ul>
                </div>
            </div>
            
            <hr class="footer-divider">
            
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="footer-copyright mb-0">
                        &copy; 2025 Digital Product Selling. Tất cả quyền được bảo lưu.
                    </p>
                </div>
                <div class="col-md-6 text-md-end">
                    <div class="footer-badges">
                        <span class="badge bg-success me-2">
                            <i class="fas fa-shield-alt"></i> Bảo mật SSL
                        </span>
                        <span class="badge bg-primary">
                            <i class="fas fa-award"></i> Được tin dùng
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
