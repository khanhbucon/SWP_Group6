@model Mo_Client.Services.AuthApiClient.UpdateShopRequest

@{
    ViewData["Title"] = "Chỉnh Sửa Shop";
}

<h2>Chỉnh Sửa Shop</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form asp-action="Edit" method="post">
    <input type="hidden" name="shopId" value="@ViewBag.ShopId" />
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Cập Nhật</button>
    <a asp-controller="Seller" asp-action="Shops" class="btn btn-secondary">Hủy</a>
</form>

<hr />
<div>
    <h5>Trạng thái hoạt động</h5>
    <div class="d-flex gap-2">
        <form method="post" action="/Shop/ToggleActive">
            <input type="hidden" name="shopId" value="@ViewBag.ShopId" />
            <input type="hidden" name="active" value="true" />
            <button type="submit" class="btn btn-success">Bật hoạt động</button>
        </form>
        <form method="post" action="/Shop/ToggleActive">
            <input type="hidden" name="shopId" value="@ViewBag.ShopId" />
            <input type="hidden" name="active" value="false" />
            <button type="submit" class="btn btn-outline-warning">Tạm dừng</button>
        </form>
    </div>
    <small class="text-muted d-block mt-2">Nút này chỉ có tác dụng khi shop đã được Admin duyệt (không áp dụng trạng thái Chờ duyệt).</small>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
